---
// Dedicated product page for /javascript. src/content/pages/javascript.md
// stays the source of truth for the agent-readable twin at /javascript.md
// (served by [...page].md.ts and bundled into the llms files). Every code
// example below is read from that file's fenced blocks, so the page and its
// Markdown cannot drift apart.
//
// Provenance of the examples:
// - The planning example type-checks against the librarium 2.0.0
//   declarations; its output below was captured by running it offline with
//   `node plan.ts` (Node 26). Planning makes no network call.
// - The terminal response is illustrative and validates against the
//   package's ResearchResponseSchema; it is not a captured run.
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import ProductHero from "../components/ProductHero.astro";
import CodePanel from "../components/CodePanel.astro";
import TerminalBlock from "../components/TerminalBlock.astro";
import { inline } from "../lib/inline-markup";
import { fencedBlocks, pickBlock } from "../lib/markdown-code";

const entry = await getEntry("pages", "javascript");
if (!entry) throw new Error("src/content/pages/javascript.md is missing");
const { title, description, ctaHref, ctaLabel } = entry.data;
const markdownHref = "/javascript.md";
const source = "src/content/pages/javascript.md";
const blocks = fencedBlocks(entry.body ?? "");
const planCode = pickBlock(blocks, "ts", "prepareResearchExecution(", source);
const validateCode = pickBlock(blocks, "ts", "ResearchResponseSchema.parse(payload)", source);
const responseJson = pickBlock(blocks, "json", '"generator": "jkudish/librarium"', source);
// The example's trailing output comments are shown as captured output instead.
const planSnippet = planCode.replace(/\n\/\/ exa \{[\s\S]*$/, "");

const boundaries = [
  {
    path: "librarium",
    lead: "Schemas and terminal interchange.",
    body: "Side-effect free and Worker-safe: response schemas, config migration and validation, and the built-in provider catalog. No provider calls on import.",
    code: "import {\n  ResearchResponseSchema,\n} from 'librarium';",
  },
  {
    path: "librarium/core",
    lead: "Planning and execution primitives.",
    body: "Worker-safe catalog construction, planning, coordinator state, and `runPreparedExecution()`. You supply adapter bindings, transport, persistence, and execution dependencies.",
    code: "import {\n  buildProviderCatalog,\n  prepareResearchExecution,\n  runPreparedExecution,\n} from 'librarium/core';",
  },
  {
    path: "librarium/node",
    lead: "Host-specific concerns.",
    body: "Filesystem configuration and trusted custom-provider loading. It is not a general high-level runner; the complete Node application is the CLI.",
    code: "import {\n  loadConfigV2,\n  loadCustomProviders,\n} from 'librarium/node';",
  },
];

// Field notes for the illustrative response, keyed to the contract.
const fields = [
  { name: "status", note: "`succeeded`, `partial`, or `failed`. It must agree with `results` and `errors`, so handle partial runs alongside successes." },
  { name: "results[].provider · profile", note: "The effective provider and Profile that produced this result. `requested_profile` records what you asked for." },
  { name: "results[].provenance", note: "Result kind, retrieval method, and corpora. Descriptive, not a confidence vote." },
  { name: "results[].citations", note: "Each cites a source with how it entered the result: `provider_reported`, `collector_extracted`, or `librarium_inferred`. URLs are untrusted." },
  { name: "usage", note: "Costs are decimal strings with a currency. A missing cost is unknown, not zero." },
  { name: "errors", note: "Namespaced error codes, with the Profile they belong to when there is one." },
];

const sectionHeading = "max-w-[22ch] text-3xl font-medium tracking-tight text-balance text-neutral-950 sm:text-5xl";
---

<Base title={`${title} | librarium`} description={description} includeSoftwareMetadata={false}>
  <Header />
  <main>
    <ProductHero title={title} description={description} ctaHref={ctaHref} ctaLabel={ctaLabel} markdownHref={markdownHref} secondary={{ href: "#plan", label: "See it in code" }}>
      <div class="rounded-lg border border-neutral-200 bg-white p-5">
        <div class="flex items-center gap-3">
          <img src="/languages/typescript.svg" alt="" width="24" height="24" class="size-6" />
          <p class="text-sm font-medium text-neutral-950">Typed, Worker-safe, v2</p>
        </div>
        <CodePanel class="mt-4" label="Terminal" lang="bash" code="npm install librarium" copyLabel="Copy" />
        <ul class="mt-4 space-y-2 text-sm/6 text-neutral-600" aria-label="Import boundaries">
          {boundaries.map((boundary) => (
            <li class="flex items-baseline gap-2"><code class="shrink-0 font-mono text-[0.85em] text-neutral-950">{boundary.path}</code><span class="text-neutral-400" aria-hidden="true">·</span><span>{boundary.lead}</span></li>
          ))}
        </ul>
      </div>
    </ProductHero>

    <!-- Planning example with captured output. -->
    <section id="plan" class="scroll-mt-6 py-16 sm:py-24" aria-labelledby="plan-heading">
      <div class="mx-auto max-w-6xl px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-x-12 gap-y-6 lg:grid-cols-2">
          <div class="min-w-0">
            <p class="font-mono text-xs tracking-wide text-amber-700 uppercase">Plan</p>
            <h2 id="plan-heading" class={`mt-3 ${sectionHeading}`}>Plan a run before anything executes.</h2>
          </div>
          <div class="min-w-0 lg:pt-8">
            <p class="text-base/7 text-pretty text-neutral-600" set:html={inline("Planning is local and network-free. Build a catalog from your provider configuration, then prepare an exact request. The prepared plan carries each selected profile's adapter binding and network-free estimate.")} />
            <p class="mt-4 text-base/7 text-pretty text-neutral-600" set:html={inline("Executing it is a separate step: `runPreparedExecution(plan.prepared, dependencies)` runs it with what you inject, namely a coordination state store (`InMemoryCoordinationStateStore` is exported), coordinator dependencies, and an attempt-execution port that calls your adapters.")} />
            <div class="mt-6 rounded-lg border border-neutral-200 bg-neutral-50 p-5">
              <p class="text-sm font-semibold text-neutral-950">There is no one-call <code class="font-mono">research()</code> client.</p>
              <p class="mt-2 text-sm/6 text-pretty text-neutral-600" set:html={inline("For a ready-made provider runtime, use the [CLI](/cli) or the [MCP server](/agents). The package's explicit boundaries are for building your own execution flow.")} />
            </div>
          </div>
        </div>
        <CodePanel class="mt-10" label="plan.ts" lang="ts" code={planSnippet} />
        <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)]">
          <div class="min-w-0">
            <TerminalBlock
              title="Output"
              kind="real"
              badge="Real output · offline"
              lines={[
                { cmd: "node plan.ts" },
                { out: "exa { estimated_cost_microusd: '17000', billable_units: undefined }" },
                { out: "kagi-fastgpt {" },
                { out: "  estimated_cost_microusd: '15000'," },
                { out: "  billable_units: [ { unit: 'requests', quantity: '1' } ]" },
                { out: "}" },
              ]}
              caption="Captured with librarium 2.0.0 on Node 26, which runs TypeScript files directly. Estimates are in micro-USD from the bundled price snapshot: $0.017 and $0.015, the same figures the CLI’s plan preview prints."
            />
          </div>
          <div class="min-w-0">
            <div class="rounded-lg border border-neutral-200 bg-white p-5">
              <p class="text-sm font-semibold text-neutral-950">What the plan holds</p>
              <ul class="mt-3 space-y-2 text-sm/6 text-pretty text-neutral-600">
                <li set:html={inline("`prepared.request`: the exact request, with one slot per selected profile.")} />
                <li set:html={inline("`prepared.profile_plans_by_identity`: each profile's adapter binding and estimate.")} />
                <li set:html={inline("`prepared.catalog`: the revision and digest of the catalog it was planned against.")} />
                <li set:html={inline("`plan.issues` when `ok` is false: coded, phase-tagged reasons, with no provider call made.")} />
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Result shape. -->
    <section id="result" class="scroll-mt-6 border-t border-neutral-200 bg-[#faf9f6] py-16 sm:py-24" aria-labelledby="result-heading">
      <div class="mx-auto max-w-6xl px-6 lg:px-8">
        <h2 id="result-heading" class={sectionHeading}>Turn a terminal response into an application feature.</h2>
        <p class="mt-5 max-w-[62ch] text-lg/8 text-pretty text-neutral-600">Validate a response at your application boundary, then render each result with its own citations. Keep raw content out of HTML sinks.</p>
        <CodePanel class="mt-12" label="evidence.ts" lang="ts" code={validateCode} />
        <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)]">
          <div class="min-w-0">
            <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
              <p class="text-sm font-medium text-neutral-950">What a terminal response looks like</p>
              <span class="rounded-sm border border-neutral-200 bg-white px-1.5 py-0.5 font-mono text-[11px] tracking-wide text-neutral-500 uppercase">Illustrative</span>
            </div>
            <CodePanel label="ResearchResponse" lang="json" code={responseJson} />
            <p class="mt-3 text-xs/5 text-pretty text-neutral-500" set:html={inline("Illustrative values, not a captured run. The object passes `ResearchResponseSchema` from librarium 2.0.0.")} />
          </div>
          <dl class="self-start rounded-lg border border-neutral-200 bg-white lg:mt-9">
            {fields.map((field, index) => (
              <div class:list={["px-5 py-4", index > 0 && "border-t border-neutral-200"]}>
                <dt class="font-mono text-sm font-semibold text-neutral-950">{field.name}</dt>
                <dd class="mt-1 text-sm/6 text-pretty text-neutral-600" set:html={inline(field.note)} />
              </div>
            ))}
          </dl>
        </div>
        <p class="mt-10 max-w-[72ch] text-base/7 text-pretty text-neutral-600">Your app still owns authentication, tenant boundaries, persistence, retention, and the interface around the evidence. Shared terminal contracts make that boundary explicit; they do not make the JavaScript and PHP runtimes interchangeable.</p>
      </div>
    </section>

    <!-- Import boundaries. -->
    <section class="py-16 sm:py-24" aria-labelledby="boundaries-heading">
      <div class="mx-auto max-w-6xl px-6 lg:px-8">
        <h2 id="boundaries-heading" class={sectionHeading}>Typed boundaries, without a Node dependency everywhere.</h2>
        <p class="mt-5 max-w-[62ch] text-lg/8 text-pretty text-neutral-600">The root and core boundaries are Worker-safe. Core does not construct a global registry or initialize concrete providers. Import only the boundary your runtime needs.</p>
        <ul class="mt-12 grid grid-cols-1 gap-6 lg:grid-cols-3">
          {boundaries.map((boundary) => (
            <li class="flex min-w-0 flex-col rounded-lg border border-neutral-200 bg-white p-6">
              <p class="font-mono text-base font-semibold text-neutral-950">{boundary.path}</p>
              <p class="mt-1 text-sm text-neutral-500">{boundary.lead}</p>
              <p class="mt-3 mb-5 text-base/7 text-pretty text-neutral-600 sm:text-sm/6" set:html={inline(boundary.body)} />
              <CodePanel class="mt-auto" label="Import" lang="ts" code={boundary.code} />
            </li>
          ))}
        </ul>
        <p class="mt-8 text-base/7 text-pretty text-neutral-600 sm:text-sm/6" set:html={inline("Install the v2 library in your project with `npm install librarium`. For the command-line tool, see [CLI installation](/docs#install). The full map of each boundary is in the [JavaScript API docs](/docs/library).")} />
      </div>
    </section>

    <!-- Distinctions and next steps. -->
    <section class="border-y border-neutral-300 bg-[#eeeae0] py-16 sm:py-24" aria-labelledby="distinctions-heading">
      <div class="mx-auto max-w-6xl px-6 lg:px-8">
        <h2 id="distinctions-heading" class={sectionHeading}>Preserve the distinctions that matter.</h2>
        <p class="mt-5 max-w-[62ch] text-lg/8 text-pretty text-neutral-600">Research a technical decision, compare answer surfaces, or collect evidence for a feature. Librarium gives those results a shared shape without pretending a search result, a grounded answer, and a research report are the same thing.</p>
        <div class="mt-12 grid grid-cols-1 gap-12 border-t border-neutral-950/15 pt-8 lg:grid-cols-3">
          <div>
            <h3 class="text-lg font-semibold text-neutral-950">Results, not just summaries</h3>
            <p class="mt-3 text-base/7 text-pretty text-neutral-600">Keep the content and citations from each successful provider.</p>
          </div>
          <div>
            <h3 class="text-lg font-semibold text-neutral-950">Provenance, not a confidence vote</h3>
            <p class="mt-3 text-base/7 text-pretty text-neutral-600">Record the effective Profile, retrieval method, and surface or collector where available.</p>
          </div>
          <div>
            <h3 class="text-lg font-semibold text-neutral-950">Explicit execution policy</h3>
            <p class="mt-3 text-base/7 text-pretty text-neutral-600">The core exposes planning and coordinator primitives; your integration supplies the operational dependencies. The complete CLI runtime supplies its own wallet and durable run storage.</p>
          </div>
        </div>
        <p class="mt-10 max-w-[72ch] text-base/7 text-pretty text-neutral-600" set:html={inline("For a concrete application-owned evidence model, read [Building answer visibility in Agentsy Report](/stories/agentsy-report). For your first executable workflow, follow [the multi-provider query guide](/guides/first-query).")} />
        <div class="mt-10 flex flex-wrap items-center gap-x-7 gap-y-4">
          <a href={ctaHref} class="inline-flex items-center gap-2 rounded bg-neutral-950 px-4 py-2.5 text-base font-medium text-white hover:bg-neutral-800 sm:text-sm">{ctaLabel} <Icon name="arrowRight" /></a>
          <a href="/cli" class="inline-flex items-center gap-2 py-2 text-base font-medium text-neutral-700 hover:text-neutral-950 sm:text-sm">Use the CLI instead</a>
          <a href={markdownHref} class="inline-flex items-center gap-2 py-2 text-base text-neutral-600 hover:text-amber-700 sm:text-sm"><Icon name="markdownLogo" class="size-5" /> Read as Markdown</a>
        </div>
      </div>
    </section>
    <p id="copy-status" role="status" class="sr-only"></p>
  </main>
  <Footer />
</Base>
