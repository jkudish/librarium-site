---
import Base from "./Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import DocsNav from "../components/DocsNav.astro";
import DocsVersionPicker from "../components/DocsVersionPicker.astro";
import { getCollection } from "astro:content";

interface Props {
  title: string;
  description?: string;
  currentSlug: string;
  version?: "v1" | "v2";
}

const { title, description, currentSlug, version = "v2" } = Astro.props;

const collection = version === "v1" ? "v1Docs" : "docs";
const root = version === "v1" ? "/v1" : "/docs";
const allDocs = await getCollection(collection);
const navItems = allDocs
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({
    slug: entry.id === "index" ? "" : entry.id,
    title: entry.data.title,
    href: entry.id === "index" ? root : `${root}/${entry.id}`,
  }));
const v1Slugs = new Set((await getCollection("v1Docs")).map((entry) => entry.id));
const v1Href = currentSlug === "index" || !v1Slugs.has(currentSlug)
  ? "/v1"
  : `/v1/${currentSlug}`;
const v2Href = currentSlug === "index" ? "/docs" : `/docs/${currentSlug}`;
const pageDescription = version === "v1"
  ? `Legacy v1 documentation. ${description ?? "Preserved for existing Librarium v1 users."}`
  : description;
---

<Base
  title={version === "v1" ? `${title} | librarium v1 legacy docs` : `${title} | librarium docs`}
  description={pageDescription}
  robots={version === "v1" ? "noindex, follow" : undefined}
  includeSoftwareMetadata={version !== "v1"}
>
  <Header />

  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    <!-- Mobile nav -->
    <div class="space-y-4 border-b border-neutral-950/10 py-4 lg:hidden">
      <DocsVersionPicker id="docs-version-mobile" version={version} v1Href={v1Href} v2Href={v2Href} />
      <details class="group border-t border-neutral-950/10 pt-4">
        <summary
          class="flex cursor-pointer list-none items-center justify-between text-sm font-semibold text-neutral-950 tracking-tight"
        >
          <span>{title}</span>
          <svg
            viewBox="0 0 16 16"
            class="size-4 shrink-0 fill-none stroke-neutral-600 stroke-[1.5] transition-transform group-open:rotate-180"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6l4 4 4-4" />
          </svg>
        </summary>
        <nav class="mt-3 flex flex-col gap-y-0.5" aria-label="Documentation pages">
          <DocsNav navItems={navItems} currentSlug={currentSlug} />
        </nav>
      </details>
    </div>

    <!-- Two-column layout -->
    <div class="flex gap-x-16 py-12">
      <!-- Sidebar (desktop only) -->
      <aside class="hidden w-52 shrink-0 lg:block">
        <div class="sticky top-8 space-y-6">
          <DocsVersionPicker id="docs-version-desktop" version={version} v1Href={v1Href} v2Href={v2Href} />
          <nav aria-label="Documentation">
          <DocsNav navItems={navItems} currentSlug={currentSlug} />
          </nav>
        </div>
      </aside>

      <!-- Main content -->
      <main class="min-w-0 flex-1">
        {version === "v1" && (
          <div class="mb-8 rounded-lg border border-amber-700/20 bg-amber-50 px-4 py-3 text-sm/6 text-amber-950">
            <strong>Legacy v1 documentation.</strong> These pages preserve the pre-v2 interfaces for existing users. <a href={v2Href} class="font-medium underline underline-offset-2">Switch to the current v2 docs.</a>
          </div>
        )}
        <h1
          class="text-3xl sm:text-4xl font-semibold tracking-tight text-balance text-neutral-950"
        >
          {title}
        </h1>
        <div class="prose max-w-[75ch] mt-2">
          <slot />
        </div>
      </main>
    </div>
  </div>

  <Footer />
</Base>
