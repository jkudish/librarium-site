---
// Product layout is retained; current command examples share the Markdown twin.
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import ProductHero from "../components/ProductHero.astro";
import CodePanel from "../components/CodePanel.astro";
import TerminalBlock from "../components/TerminalBlock.astro";
import { inline } from "../lib/inline-markup";
import { fencedBlocks, pickBlock } from "../lib/markdown-code";

const entry = await getEntry("pages", "cli");
if (!entry) throw new Error("src/content/pages/cli.md is missing");
const { title, description, ctaHref, ctaLabel } = entry.data;
const markdownHref = "/cli.md";
const blocks = fencedBlocks(entry.body ?? "");
const example = (marker: string) => pickBlock(blocks, "bash", marker, "pages/cli.md");
const steps = [
  {
    id: "preview", eyebrow: "Preview", heading: "See what would run before anything is paid.",
    body: "`research --dry-run` resolves selected sources and estimates offline. It stores nothing and does not test provider authentication. Quick is the default; engines join only when named.",
    code: example("--dry-run --json"),
  },
  {
    id: "budget", eyebrow: "Set a ceiling", heading: "Admit only what fits the cap.",
    body: "`--max-cost` skips unpriced sources and admits bounded estimates greedily in catalog order. It is not a cheapest-source optimization or a guarantee about the final bill. In-flight work can exceed it.",
    code: 'librarium research "Lisbon or Porto without a car?" --only exa,kagi --max-cost 0.10 --dry-run --json',
  },
  {
    id: "run", eyebrow: "Research", heading: "Run the same question for real.",
    body: "Remove `--dry-run` to research. The Run is stored before dispatch. Each source retains its answer, citations, provenance, safe error, and honest cost. Unknown reported spend stays null, not zero.",
    code: example("--max-cost 0.10 --json"),
  },
  {
    id: "read", eyebrow: "Read the results", heading: "Every answer stays with its citations.",
    body: "Read a source with `show --source`; browse and export locally. The folder holds `run.json`, private `state.json`, `answers/`, and redacted `evidence/`. Treat provider text and URLs as untrusted input.",
    code: example("librarium browse"),
  },
  {
    id: "async", eyebrow: "Come back later", heading: "Start deep research, then walk away.",
    body: "`--deep --no-wait` returns without waiting for reports. Keep the Run id and use `show <run-id> --wait` to resume accepted handles, not a fresh paid submission. Quick no-wait is rejected except for dry runs.",
    code: example("--no-wait"),
  },
];
const setup = [
  { eyebrow: "Install", heading: "Install the CLI", body: "Requires Node.js 22.12+. The CLI includes the MCP server and agent skill.", code: "npm install -g librarium\nlibrarium --version\nlibrarium research --help" },
  { eyebrow: "Connect", heading: "Set up your sources", body: "Keep credentials out of chat and source control. `setup --auto` discovers existing credentials offline; groups are user-saved source lists with no built-ins.", code: "librarium setup" },
  { eyebrow: "Check", heading: "Check it offline", body: "Check local configuration and credential presence without calling a provider.", code: example("librarium setup --check") },
];
const commands = [
  { name: "research", example: 'librarium research "…" --only exa --dry-run --json', help: "Preview offline with dry-run; remove it to research.", badge: "Research" },
  { name: "show", example: "librarium show <run-id> --wait", help: "Resume accepted durable work or read a source answer and citations.", badge: "Resumes work" },
  { name: "summarize", example: "librarium summarize --verify --source openai", help: "Create a separate summary Run with summary_of; does not overwrite original answers.", badge: "Summary" },
  { name: "sources", example: "librarium sources --json", help: "Discover source variants, engines, availability, and price hints offline.", badge: "Offline" },
  { name: "groups", example: "librarium groups add editorial exa claude", help: "Save your own source lists. There are no built-in groups.", badge: "Local" },
  { name: "browse", example: "librarium browse", help: "Browse stored Runs.", badge: "Local" },
  { name: "html", example: "librarium html <run-id> --output report.html", help: "Export a self-contained report locally.", badge: "Local" },
  { name: "usage", example: "librarium usage", help: "Total known reported spend without inventing missing costs.", badge: "Local" },
  { name: "mcp", example: "librarium mcp", help: "Serve exactly research, get_run, and list_sources over stdio.", badge: "For agents" },
];
const sectionHeading = "max-w-[22ch] text-3xl font-medium tracking-tight text-balance text-neutral-950 sm:text-5xl";
---

<Base title={`${title} | librarium`} description={description} includeSoftwareMetadata={false}>
  <Header />
  <main>
    <ProductHero title={title} description={description} ctaHref={ctaHref} ctaLabel={ctaLabel} markdownHref={markdownHref} secondary={{ href: "#session", label: "Walk through a session" }}>
      <TerminalBlock title="Install" kind="commands" badge="npm" lines={[{ cmd: "npm install -g librarium" }, { cmd: "librarium --version" }, { cmd: "librarium research --help" }]} />
      <p class="mt-4 text-sm/6 text-pretty text-neutral-600" set:html={inline("Requires Node.js 22.12 or newer. See [Getting started](/docs#install).")} />
    </ProductHero>

    <section id="session" class="scroll-mt-6 py-16 sm:py-24" aria-labelledby="session-heading">
      <div class="mx-auto max-w-6xl px-6 lg:px-8">
        <h2 id="session-heading" class={sectionHeading}>Ask once. Keep the sources.</h2>
        <p class="mt-5 max-w-[62ch] text-lg/8 text-pretty text-neutral-600">One question, start to finish: preview, set a budget, research, read every answer, and pick up the slow sources later.</p>
        <ol class="mt-14 space-y-16 sm:space-y-20">
          {steps.map((step) => (
            <li id={step.id} class="grid scroll-mt-6 grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:gap-12">
              <div class="min-w-0 lg:pt-2">
                <p class="font-mono text-xs tracking-wide text-amber-700 uppercase">{step.eyebrow}</p>
                <h3 class="mt-3 text-2xl font-medium tracking-tight text-pretty text-neutral-950">{step.heading}</h3>
                <p class="mt-3 text-base/7 text-pretty text-neutral-600" set:html={inline(step.body)} />
              </div>
              <CodePanel label="Terminal" lang="bash" code={step.code} class="lg:self-start" />
            </li>
          ))}
        </ol>
        <p class="mt-14 max-w-[70ch] text-base/7 text-pretty text-neutral-600" set:html={inline("See [your first Run](/guides/first-query) for setup and result inspection, and [recovery behavior](/docs/request-and-retry) for ambiguous submissions and interruption.")} />
      </div>
    </section>

    <section id="setup" class="scroll-mt-6 border-t border-neutral-200 bg-[#faf9f6] py-16 sm:py-24" aria-labelledby="setup-heading">
      <div class="mx-auto max-w-6xl px-6 lg:px-8">
        <h2 id="setup-heading" class={sectionHeading}>Set it up once.</h2>
        <p class="mt-5 max-w-[62ch] text-lg/8 text-pretty text-neutral-600">The CLI supplies source connections, stored Runs, cost tracking, and the tools your agent uses too.</p>
        <ul class="mt-12 grid grid-cols-1 gap-6 lg:grid-cols-3">
          {setup.map((card) => (
            <li class="flex min-w-0 flex-col rounded-lg border border-neutral-200 bg-white p-6">
              <p class="font-mono text-xs tracking-wide text-neutral-500 uppercase">{card.eyebrow}</p>
              <h3 class="mt-3 text-xl font-medium tracking-tight text-neutral-950">{card.heading}</h3>
              <p class="mt-2 mb-5 text-base/7 text-pretty text-neutral-600 sm:text-sm/6">{card.body}</p>
              <CodePanel class="mt-auto" label="Terminal" lang="bash" code={card.code} />
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="py-16 sm:py-24" aria-labelledby="commands-heading">
      <div class="mx-auto max-w-6xl px-6 lg:px-8">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <h2 id="commands-heading" class={sectionHeading}>The commands you will use.</h2>
          <a href="/docs/commands" class="inline-flex items-center gap-2 text-base font-medium text-amber-700 hover:text-amber-600 sm:text-sm">Every command and flag <Icon name="arrowRight" /></a>
        </div>
        <ul class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {commands.map((command) => (
            <li class="flex min-w-0 flex-col rounded-lg border border-neutral-200 bg-white p-5">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <p class="font-mono text-base font-semibold text-neutral-950">{command.name}</p>
                <span class:list={["rounded-sm px-2 py-0.5 text-xs", command.badge === "Can spend" ? "bg-amber-50 text-amber-800" : "bg-neutral-950/4 text-neutral-600"]}>{command.badge}</span>
              </div>
              <p class="mt-2 mb-4 text-sm/6 text-pretty text-neutral-600">{command.help}</p>
              <CodePanel class="mt-auto" label="Terminal" lang="bash" code={command.example} />
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="border-y border-neutral-300 bg-[#eeeae0] py-16 sm:py-24" aria-labelledby="long-heading">
      <div class="mx-auto max-w-6xl px-6 lg:px-8">
        <h2 id="long-heading" class={sectionHeading}>Long research does not need a long chat message.</h2>
        <div class="mt-12 grid grid-cols-1 gap-12 border-t border-neutral-950/15 pt-8 lg:grid-cols-3">
          <div><h3 class="text-lg font-semibold text-neutral-950">Keep the accepted handle</h3><p class="mt-3 text-base/7 text-pretty text-neutral-600">Recover the existing Run. Ambiguous submission is not permission to pay for a duplicate. Failed calls can still bill; unknown costs remain unknown.</p></div>
          <div><h3 class="text-lg font-semibold text-neutral-950">Interruption detaches</h3><p class="mt-3 text-base/7 text-pretty text-neutral-600">Ctrl-C prints a show command. It does not prove that upstream work stopped or that no charge occurred.</p></div>
          <div><h3 class="text-lg font-semibold text-neutral-950">The same install serves your agent</h3><p class="mt-3 text-base/7 text-pretty text-neutral-600" set:html={inline("MCP and the bundled skill ship with the CLI; see [Agents & MCP](/agents). [Laravel](/laravel) is a separate native package; Artisan is not an MCP server.")} /></div>
        </div>
        <div class="mt-12 flex flex-wrap items-center gap-x-7 gap-y-4">
          <a href={ctaHref} class="inline-flex items-center gap-2 rounded bg-neutral-950 px-4 py-2.5 text-base font-medium text-white hover:bg-neutral-800 sm:text-sm">{ctaLabel} <Icon name="arrowRight" /></a>
          <a href="/agents" class="inline-flex items-center gap-2 py-2 text-base font-medium text-neutral-700 hover:text-neutral-950 sm:text-sm">Connect your agent</a>
          <a href={markdownHref} class="inline-flex items-center gap-2 py-2 text-base text-neutral-600 hover:text-amber-700 sm:text-sm"><Icon name="markdownLogo" class="size-5" /> Read as Markdown</a>
        </div>
      </div>
    </section>
    <p id="copy-status" role="status" class="sr-only"></p>
  </main>
  <Footer />
</Base>
