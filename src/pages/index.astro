---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Icon from "../components/Icon.astro";
import CommandText from "../components/CommandText.astro";
import CodePanel from "../components/CodePanel.astro";
import Base from "../layouts/Base.astro";
import EvidenceControls from "../components/EvidenceControls.astro";
import { WORKFLOWS, FEATURED_SOURCES, FEATURED_ENGINES, SOURCE_COUNT, ENGINE_COUNT } from "../data/product";
import { RESEARCH_DEMO, RUN_EXAMPLE, COMPARED_TOOLS, PROVIDER_COMPARISON, formatElapsed, renderCapturedMarkdown } from "../data/research-demo";
import { INSTALL_CHOICES, PROMPT_EXPAND_LABEL } from "../data/setup-prompt";

const providerMark = (logo: string) => `/providers/${logo}.${["you", "serpapi", "dataforseo"].includes(logo) ? "png" : "svg"}`;
const capturedCommand = `librarium research "${RESEARCH_DEMO.query}" --deep`;
const products = [
  { title: "Agents & MCP", description: "Let your agent ask questions and read the answers through the bundled skill and MCP server.", href: "/agents", link: "Explore Agents & MCP" },
  { title: "CLI", description: "Ask from your terminal, save a Run, and return to the evidence later.", href: "/cli", link: "Explore the CLI" },
  { title: "JavaScript / TypeScript", description: "Build research into Node services, Workers, and your own execution flow with a typed client.", href: "/javascript", link: "Explore JavaScript" },
  { title: "PHP / Laravel", description: "Use a native Laravel package with Artisan commands, encrypted queue jobs, and a testing fake.", href: "/laravel", link: "Explore Laravel" },
];
---

<Base title="Librarium — give your agent more than one source" description="Query search engines, AI answer engines, and deep-research APIs from one interface, and keep every answer with its citations." bodyClass="bg-[#faf9f6]">
  <div class="isolate antialiased">
    <Header />
    <main>
      <section class="pt-14 sm:pt-24">
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
          <div class="mx-auto max-w-4xl text-center">
            <p class="text-base text-neutral-600 sm:text-sm">A meta harness for research queries</p>
            <h1 class="mt-6 text-4xl font-medium tracking-tight text-balance text-neutral-950 sm:text-7xl lg:text-[5.5rem]">Give your agent more than one source.</h1>
            <p class="mx-auto mt-7 max-w-[60ch] text-lg/8 text-pretty text-neutral-600">Query search engines, AI answer engines, and deep-research APIs from one interface, and keep every answer with its citations.</p>
            <div id="install" class="mx-auto mt-8 max-w-2xl scroll-mt-8 rounded-lg border border-neutral-300 bg-white p-4 text-left sm:p-5">
              <h2 class="sr-only">Set up Librarium</h2>
              <div id="install-tabs" role="tablist" aria-label="Install Librarium" class="grid grid-cols-4 gap-1 rounded bg-neutral-100 p-1">
                {INSTALL_CHOICES.map((choice, index) => (
                  <button id={`install-tab-${choice.id}`} type="button" role="tab" aria-selected={index === 0 ? "true" : "false"} aria-controls={`install-panel-${choice.id}`} tabindex={index === 0 ? 0 : -1} class="min-h-11 cursor-pointer rounded px-1 text-sm font-medium text-neutral-600 aria-selected:bg-white aria-selected:text-neutral-950 aria-selected:shadow-sm hover:text-neutral-950 sm:text-base">{choice.label}</button>
                ))}
              </div>
              {INSTALL_CHOICES.map((choice, index) => (
                <div id={`install-panel-${choice.id}`} role="tabpanel" aria-labelledby={`install-tab-${choice.id}`} tabindex="0" hidden={index !== 0} data-install-panel data-install-method={choice.id}>
                  <div class="mt-4 flex items-start gap-3">
                    <pre id={`install-text-${choice.id}`} class:list={["min-w-0 flex-1 whitespace-pre-wrap break-words text-base/7 text-neutral-800 sm:text-sm/6", choice.id === "agent" ? "install-prompt font-sans" : "font-mono"]}><code>{choice.text}</code></pre>
                    <button type="button" data-code-copy data-copy={choice.text} data-copy-state="idle" aria-label={`Copy ${choice.label === "Agent" ? "agent setup prompt" : `${choice.label} install commands`}`} class="group flex min-h-11 shrink-0 cursor-pointer items-center gap-2 rounded border border-neutral-300 px-3 text-sm text-neutral-700 hover:bg-neutral-100">
                      <Icon name="copy" class="size-4 group-data-[copy-state=success]:hidden" /><Icon name="check" class="hidden size-4 text-amber-800 group-data-[copy-state=success]:block" /><span class="copy-label">Copy</span>
                    </button>
                  </div>
                  <div class="mt-3 flex flex-wrap items-center justify-between gap-2 text-base text-amber-800 sm:text-sm">
                    {choice.id === "agent" && <button id="expand-prompt" type="button" aria-expanded="false" aria-controls="install-text-agent" class="min-h-10 cursor-pointer underline underline-offset-4 hover:text-amber-600">{PROMPT_EXPAND_LABEL}</button>}
                    <a href={choice.href} class="py-2 font-medium hover:text-amber-600">Full install guide →</a>
                  </div>
                </div>
              ))}
              <p id="copy-status" role="status" class="mt-1 text-sm text-neutral-600 empty:sr-only"></p>
              <noscript><style>[data-install-panel] { display: block !important; margin-top: 1rem; } .install-prompt { display: block !important; } #install-tabs { display: none; }</style></noscript>
            </div>
            <p class="mt-4 text-base font-medium text-neutral-700 sm:text-sm"><a href="#research-example" class="py-3 hover:text-neutral-950">See an example <Icon name="arrowUpRight" class="inline-block" /></a></p>
          </div>

          <div id="research-example" role="region" tabindex="-1" aria-label="Captured research demo — playback, not live" class="mt-12 min-w-0 scroll-mt-6 overflow-hidden border border-neutral-300 bg-white sm:mt-16">
            <div class="flex flex-col justify-between gap-4 border-b border-neutral-200 px-5 pt-6 sm:flex-row sm:items-end sm:px-7">
              <h2 class="pb-4 text-2xl font-medium tracking-tight text-neutral-950 sm:pb-6">One question. Multiple providers.</h2>
              <div id="example-tabs" role="tablist" aria-label="Example format" hidden class="flex shrink-0 gap-5">
                {[{ id: "readable", label: "Answers" }, { id: "compare", label: "Compare" }, { id: "json", label: "JSON" }].map((tab, index) => (
                  <button id={`example-${tab.id}-tab`} type="button" role="tab" aria-selected={index === 0 ? "true" : "false"} aria-controls={`example-${tab.id}`} tabindex={index === 0 ? 0 : -1} class="min-h-12 cursor-pointer border-b-2 border-transparent px-1 py-3 text-base font-medium text-neutral-500 aria-selected:border-amber-700 aria-selected:text-amber-800 hover:text-neutral-950 sm:text-sm">{tab.label}</button>
                ))}
              </div>
            </div>
            <div class="border-b border-neutral-200 px-5 py-5 sm:px-7">
              <p id="demo-action" class="text-base font-medium text-amber-800 sm:text-sm">Captured deep research</p>
              <!-- The question is always complete, including during playback. -->
              <p id="demo-query" class="mt-2 text-xl/7 font-medium break-words text-neutral-950">{RESEARCH_DEMO.query}</p>
              <pre class="mt-3 whitespace-pre-wrap break-words font-mono text-sm/6 text-neutral-600"><code class="language-sh"><CommandText command={capturedCommand} /></code></pre>
              <p class="mt-2 text-base/6 text-neutral-500 sm:text-sm/6">Captured September 18, 2026. Playback makes no provider calls; durations are historical, not a speed promise. Answers are excerpts of the captured reports.</p>
            </div>
            <div id="example-readable" role="tabpanel" aria-labelledby="example-readable-tab" tabindex="0" class="px-5 py-6 sm:px-7">
              <div id="demo-providers" role="tablist" aria-label="Provider results" class="flex min-h-11 gap-2 overflow-x-auto pb-1">
                {RESEARCH_DEMO.results.map((result, index) => (
                  <button type="button" role="tab" id={`demo-tab-${index}`} data-demo-tab={index} data-demo-state="done" aria-selected={index === 0 ? "true" : "false"} aria-controls={`demo-panel-${index}`} tabindex={index === 0 ? 0 : -1} title={result.provider} class="demo-tab flex min-h-11 shrink-0 cursor-pointer items-center gap-2 rounded border px-3 py-2 text-sm">
                    <img src={providerMark(result.logo)} alt="" width="20" height="20" class="size-5 shrink-0" /><span class="whitespace-nowrap font-medium">{result.shortName}</span><span class="demo-dot size-1.5 shrink-0 rounded-full" aria-hidden="true"></span><span class="min-w-[7ch] text-left font-mono tabular-nums" data-demo-status>{formatElapsed(result.elapsedSeconds)}</span>
                  </button>
                ))}
              </div>
              <noscript><style>[data-demo-panel] { display: block !important; } [data-demo-heading] { position: static !important; width: auto !important; height: auto !important; clip-path: none !important; }</style></noscript>
              {RESEARCH_DEMO.results.map((result, index) => (
                <div id={`demo-panel-${index}`} role="tabpanel" aria-labelledby={`demo-tab-${index}`} data-demo-panel={index} data-demo-final={formatElapsed(result.elapsedSeconds)} tabindex="0" hidden={index !== 0} class="mt-4">
                  <h3 class="sr-only" data-demo-heading>{result.provider}</h3>
                  <div class="demo-pending hidden border-t border-neutral-200 py-8 text-neutral-500" aria-hidden="true">Playing captured answer…</div>
                  <div data-demo-body class="max-h-[30rem] overflow-y-auto border-t border-neutral-200 pt-4 sm:max-h-[26rem]">
                    {result.title && <h4 class="max-w-[60ch] text-lg font-medium text-pretty text-neutral-950">{result.title}</h4>}
                    <p class="mt-1 text-sm/6 text-neutral-500">{result.modelLabel}</p>
                    <div class="demo-report mt-3 text-base/7 text-neutral-600 sm:text-sm/6" set:html={renderCapturedMarkdown(result.displayContent)} />
                    <div data-demo-citations class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-sm text-neutral-500">
                      {result.citations.filter((citation) => !citation.url.includes("vertexaisearch.cloud.google.com")).slice(0, 3).map((citation) => (
                        <a href={citation.url} target="_blank" rel="noopener noreferrer" class="underline decoration-neutral-300 underline-offset-4 hover:text-amber-800">{citation.title} <Icon name="arrowUpRight" class="inline-block" /></a>
                      ))}
                      <span>{result.citations.length} citations in the capture</span>
                    </div>
                  </div>
                </div>
              ))}
              <div class="mt-4 flex justify-end"><button id="demo-replay" type="button" hidden class="min-h-10 cursor-pointer rounded border border-neutral-300 px-3 text-sm text-neutral-700 hover:bg-neutral-100">Replay capture</button></div>
            </div>
            <div id="example-compare" role="tabpanel" aria-labelledby="example-compare-tab" tabindex="0" hidden class="px-5 py-6 sm:px-7">
              <div class="grid items-start gap-8 lg:grid-cols-[3fr_2fr]">
                <div class="min-w-0">
                  <h3 class="text-lg font-medium text-neutral-950">Which tools did each excerpt name?</h3>
                  <p class="mt-2 text-base/6 text-neutral-600 sm:text-sm/6">A mention is not an endorsement. “—” means the tool is not in the displayed excerpt, not that the full report ruled it out.</p>
                  <ul role="list" data-compare-list class="mt-4 divide-y divide-neutral-200 sm:hidden">
                    {PROVIDER_COMPARISON.map((row) => <li class="py-3 text-base/6 text-neutral-700"><p class="font-medium">{row.provider}</p><p class="mt-1 text-neutral-500">{row.named.length ? row.named.join(", ") : "None of these four tools named in the excerpt"}</p></li>)}
                  </ul>
                  <div class="mt-4 overflow-x-auto max-sm:hidden">
                    <table class="compare-table w-full text-left text-sm text-neutral-700">
                      <thead><tr><th scope="col">Provider</th>{COMPARED_TOOLS.map((tool) => <th scope="col">{tool}</th>)}</tr></thead>
                      <tbody>{PROVIDER_COMPARISON.map((row) => <tr><th scope="row">{row.provider}</th>{COMPARED_TOOLS.map((tool) => <td><span aria-label={row.named.includes(tool) ? "Named in excerpt" : "Not in excerpt"}>{row.named.includes(tool) ? "✓" : "—"}</span></td>)}</tr>)}</tbody>
                    </table>
                  </div>
                </div>
                <EvidenceControls agreement />
              </div>
            </div>
            <div id="example-json" role="tabpanel" aria-labelledby="example-json-tab" tabindex="0" hidden class="px-5 py-6 sm:px-7">
              <p class="mb-4 text-base/7 text-neutral-600 sm:text-sm/6">Current Run shape: an unchanged, single-result <code>librarium.run/1</code> contract fixture. This is a separate example, not the historical capture above.</p>
              <CodePanel label="Run contract fixture" code={JSON.stringify(RUN_EXAMPLE, null, 2)} lang="json" scroll />
            </div>
          </div>
        </div>
      </section>

      <section id="features" class="py-16 sm:py-24">
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
          <div class="flex flex-wrap items-baseline justify-between gap-4">
            <h2 class="text-4xl font-medium tracking-tight text-balance text-neutral-950 sm:text-5xl">Choose how far to go.</h2>
            <p class="text-base font-medium text-amber-800 sm:text-sm"><a href="/docs/groups-and-modes" class="hover:text-amber-600">Depth and source selection <Icon name="arrowUpRight" class="inline-block" /></a></p>
          </div>
          <ul role="list" class="mt-8 divide-y divide-neutral-300 border-t border-neutral-300">
            {WORKFLOWS.map((workflow) => (
              <li data-workflow={workflow.id} class="grid min-w-0 gap-5 py-7 lg:grid-cols-[3fr_2fr] lg:items-center lg:gap-12">
                <div>
                  <p class="text-base font-medium text-amber-800 sm:text-sm">{workflow.id === "deep" ? "Deep research" : workflow.id === "engines" ? "AI answer engines · select by name" : "Quick research · default"}</p>
                  <h3 class="mt-3 text-2xl font-medium tracking-tight text-neutral-950">{workflow.title}</h3>
                  <p class="mt-3 max-w-[65ch] text-base/7 text-pretty text-neutral-600">{workflow.summary}</p>
                </div>
                <CodePanel label={`${workflow.id === "engines" ? "AI answer engines" : workflow.id} command`} code={workflow.command} lang="bash" />
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="border-y border-neutral-300 bg-[#eeeae0] py-16 sm:py-24" aria-labelledby="controls-heading">
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
          <h2 id="controls-heading" class="text-4xl font-medium tracking-tight text-balance text-neutral-950 sm:text-5xl">Keep the evidence. Keep control.</h2>
          <EvidenceControls />
        </div>
      </section>

      <section id="providers" class="py-16 sm:py-24">
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
          <h2 class="text-4xl font-medium tracking-tight text-balance text-neutral-950 sm:text-5xl">Many sources. One interface.</h2>
          <p class="mt-5 max-w-[70ch] text-base/7 text-pretty text-neutral-600">The shared catalog includes {SOURCE_COUNT} research sources and {ENGINE_COUNT} AI answer engines. Quick and deep capabilities vary by source; JavaScript and Laravel support can differ.</p>
          <h3 class="mt-10 text-lg font-medium text-neutral-950">Research sources</h3>
          <ul role="list" class="mt-4 grid grid-cols-2 border-t border-l border-neutral-200 sm:grid-cols-4 lg:grid-cols-8" aria-label="Research sources">
            {FEATURED_SOURCES.map((provider) => (
              <li data-source={provider.id} class="flex flex-col items-center gap-3 border-r border-b border-neutral-200 px-2 py-6 text-center">
                <div class="provider-logo"><img src={providerMark(provider.logo)} alt="" width="28" height="28" loading="lazy" class="logo-mono size-7 object-contain grayscale" /></div>
                <p class="text-base text-neutral-700 sm:text-sm">{provider.name}</p><p class="text-sm text-neutral-500">{provider.hint}</p>
              </li>
            ))}
          </ul>
          <h3 class="mt-8 text-lg font-medium text-neutral-950">AI answer engines · choose by name</h3>
          <ul role="list" class="mt-4 grid grid-cols-1 border-t border-l border-neutral-200 sm:grid-cols-5" aria-label="AI answer engines">
            {FEATURED_ENGINES.map((engine) => (
              <li data-engine={engine.id} class="flex items-center gap-3 border-r border-b border-neutral-200 p-4 text-base text-neutral-700 sm:flex-col sm:text-center sm:text-sm">
                <div class="provider-logo">{engine.logo ? <img src={providerMark(engine.logo)} alt="" width="28" height="28" loading="lazy" class="logo-mono size-7 object-contain grayscale" /> : <span class="font-mono font-medium" aria-hidden="true">{engine.monogram}</span>}</div>
                <p>{engine.name}</p>
              </li>
            ))}
          </ul>
          <div class="mt-6 flex flex-wrap gap-5 text-base font-medium text-amber-800 sm:text-sm">
            <a href="/docs/providers" class="hover:text-amber-600">JavaScript provider capabilities →</a>
            <a href="/docs/php/providers" class="hover:text-amber-600">Laravel provider capabilities →</a>
            <a href="/docs/custom-providers" class="hover:text-amber-600">Add a custom source →</a>
          </div>
        </div>
      </section>

      <section id="library" class="bg-neutral-950 py-16 sm:py-24">
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
          <h2 class="text-4xl font-medium tracking-tight text-balance text-white sm:text-5xl">Use Librarium where you build.</h2>
          <div class="mt-10 grid items-start gap-8 sm:grid-cols-2 lg:grid-cols-4">
            {products.map((product) => (
              <article class="border-t border-white/20 pt-6">
                <h3 class="text-xl font-medium text-white">{product.title}</h3>
                <p class="mt-3 text-base/7 text-pretty text-neutral-400 sm:text-sm/6">{product.description}</p>
                <p class="mt-4 text-base font-medium text-amber-200 sm:text-sm"><a href={product.href} class="py-2 hover:text-white">{product.link} <Icon name="arrowUpRight" class="inline-block" /></a></p>
              </article>
            ))}
          </div>
          <p class="mt-8 max-w-[75ch] text-base/7 text-neutral-400 sm:text-sm/6">The CLI and JavaScript library share one implementation. Laravel is a separate native package. Both return a Run with answers and citations; provider support and execution behavior can differ.</p>
        </div>
      </section>

      <section class="bg-[#efb86b] py-16 sm:py-24" aria-labelledby="setup-heading">
        <div class="mx-auto grid max-w-6xl items-center gap-8 px-6 lg:grid-cols-2 lg:px-8">
          <div>
            <h2 id="setup-heading" class="text-4xl font-medium tracking-tight text-balance text-neutral-950 sm:text-5xl">Put your sources to work.</h2>
            <p class="mt-6 max-w-[50ch] text-base/7 text-neutral-800">Install Librarium, connect your sources, and preview your first query. Use it yourself or hand the research to your agent.</p>
          </div>
          <p class="text-lg font-medium lg:justify-self-end"><a href="#install" class="inline-flex items-center gap-3 rounded-md bg-neutral-950 px-8 py-4 text-white hover:bg-neutral-800">Set up Librarium <span aria-hidden="true">→</span></a></p>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</Base>

<style>
  .install-prompt { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
  .install-prompt[data-expanded="true"] { display: block; }
  .provider-logo { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 3rem; height: 3rem; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-md); background: var(--color-neutral-100); }
  .demo-report { overflow-x: auto; }
  .demo-report :global(a) { text-decoration: underline; text-underline-offset: 2px; color: inherit; }
  .demo-report > :global(* + *) { margin-top: 0.5rem; }
  .demo-report :global(h4) { font-weight: 500; }
  .demo-report :global(ul) { list-style: disc; padding-left: 1.15rem; }
  .demo-report :global(table) { width: 100%; min-width: 40rem; border-collapse: collapse; text-align: left; }
  .demo-report :global(th), .demo-report :global(td), .compare-table :is(th, td) { border-bottom: 1px solid var(--color-neutral-200); padding: 0.75rem; vertical-align: top; }
  .compare-table th { font-weight: 500; }
  .compare-table td { text-align: center; }
  .demo-tab { border-color: var(--color-neutral-200); color: var(--color-neutral-700); }
  .demo-tab:hover { background: var(--color-neutral-100); }
  .demo-tab[aria-selected="true"] { border-color: var(--color-amber-700); background: var(--color-amber-50); color: var(--color-amber-800); }
  .demo-dot { background: var(--color-neutral-300); }
  .demo-tab[aria-selected="true"] .demo-dot { background: var(--color-amber-600); }
  [data-demo-panel]:is([data-demo-state="running"], [data-demo-state="queued"]) .demo-pending { display: block; }
  :global(:root[data-theme="dark"]) .demo-tab[aria-selected="true"] { border-color: #efc184; background: #2b2720; color: #efc184; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .demo-tab[aria-selected="true"] { border-color: #efc184; background: #2b2720; color: #efc184; }
  }
  @media (prefers-reduced-motion: no-preference) {
    #research-example[data-demo-playing="true"] [data-demo-state="done"] :global([data-demo-word]) { animation: demo-word 320ms ease-out both; animation-delay: calc(var(--demo-word, 0) * var(--demo-word-ms, 30ms)); }
    @keyframes demo-word { from { opacity: 0; } to { opacity: 1; } }
  }
  /* Shared CodePanel preserves its toolbar/copy behavior; homepage commands
     wrap instead of requiring a horizontal scroll on narrow screens. */
  [data-workflow] :global(pre), #example-json :global(pre) { white-space: pre-wrap; overflow-wrap: anywhere; }
</style>

<script>
  import { PROMPT_EXPAND_LABEL } from "../data/setup-prompt";
  import { initResearchDemo } from "../scripts/research-demo";
  initResearchDemo();

  // Each tab owns its visible payload and guide link. Selection never changes
  // any unrelated navigation target, including the final setup CTA.
  function activate(tabs: HTMLButtonElement[], selected: HTMLButtonElement) {
    for (const tab of tabs) {
      const active = tab === selected;
      tab.setAttribute("aria-selected", String(active));
      tab.tabIndex = active ? 0 : -1;
      const panel = document.getElementById(tab.getAttribute("aria-controls")!);
      if (panel) panel.hidden = !active;
    }
  }
  for (const id of ["install-tabs", "example-tabs"]) {
    const list = document.getElementById(id);
    const tabs = [...list?.querySelectorAll<HTMLButtonElement>("[role=tab]") ?? []];
    for (const [index, tab] of tabs.entries()) {
      tab.addEventListener("click", () => activate(tabs, tab));
      tab.addEventListener("keydown", (event) => {
        let next: number;
        switch (event.key) {
          case "ArrowRight": next = (index + 1) % tabs.length; break;
          case "ArrowLeft": next = (index + tabs.length - 1) % tabs.length; break;
          case "Home": next = 0; break;
          case "End": next = tabs.length - 1; break;
          default: return;
        }
        event.preventDefault();
        activate(tabs, tabs[next]);
        tabs[next].focus();
      });
    }
    if (list) list.hidden = false;
  }
  const expand = document.getElementById("expand-prompt");
  const prompt = document.getElementById("install-text-agent");
  expand?.addEventListener("click", () => {
    const expanded = expand.getAttribute("aria-expanded") !== "true";
    expand.setAttribute("aria-expanded", String(expanded));
    if (prompt) prompt.dataset.expanded = String(expanded);
    expand.textContent = expanded ? "Show less" : PROMPT_EXPAND_LABEL;
  });
</script>
