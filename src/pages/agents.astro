              </div>
              <div class="code-panel mt-4 min-w-0">
                <div class="code-toolbar"><span>Paste into {host.id === "other" ? "your agent" : host.name}</span><button type="button" class="copy-btn group" data-copy={agentSetupPromptFor(host.id === "other" ? "my coding agent" : host.name)} data-copy-state="idle" aria-label={`Copy setup prompt for ${host.name}`}><Icon name="copy" class="size-4 group-data-[copy-state=success]:hidden" /><Icon name="check" class="hidden size-4 text-amber-300 group-data-[copy-state=success]:block" /><span class="copy-label">Copy prompt</span></button></div>
                <p class="px-5 py-4 font-mono text-xs/6 break-words whitespace-pre-wrap text-amber-100">{agentSetupPromptFor(host.id === "other" ? "my coding agent" : host.name)}</p>
              </div>
              <p class="mt-6 text-sm font-medium text-neutral-950">Or register it yourself</p>
              <p class="mt-1 max-w-[75ch] text-base/7 text-pretty text-neutral-600 sm:text-sm/6" set:html={inline(host.intro)} />
              {host.blocks.length > 0 && (
                <div class:list={["mt-4 grid gap-4", host.blocks.length > 1 && "lg:grid-cols-2"]}>
                  {host.blocks.map((block) => (
                    <div class="code-panel min-w-0">
                      <div class="code-toolbar"><span>{block.label}</span><button type="button" class="copy-btn group" data-copy={block.code} data-copy-state="idle" aria-label={`Copy ${host.name} ${block.label === "Terminal" ? "command" : block.label}`}><Icon name="copy" class="size-4 group-data-[copy-state=success]:hidden" /><Icon name="check" class="hidden size-4 text-amber-300 group-data-[copy-state=success]:block" /><span class="copy-label">Copy</span></button></div>
                      <Code code={block.code} lang={block.lang} theme="github-dark-default" />
                    </div>
                  ))}
                </div>
              )}
              {host.id === "other" && (
                <dl class="mt-4 grid max-w-md grid-cols-[auto_1fr] gap-x-6 gap-y-2 rounded-md border border-neutral-200 bg-neutral-50 p-4 font-mono text-sm">
                  <dt class="text-neutral-500">name</dt><dd class="text-neutral-950">librarium</dd>
                  <dt class="text-neutral-500">transport</dt><dd class="text-neutral-950">stdio</dd>
                  <dt class="text-neutral-500">command</dt><dd class="text-neutral-950">librarium</dd>
                  <dt class="text-neutral-500">args</dt><dd class="text-neutral-950">["mcp"]</dd>
                </dl>
              )}
