---
// "Keep the evidence. Keep control." vignettes (PlanMode #4912).
// Provider content and durations retain the historical capture. Commands
// illustrate the simplified surface; do not present them as captured output.
// - Provenance: the captured deep-research run in research-demo.ts (same
//   data as the hero demo): providers whose report names the finding, each
//   with its most-cited matching source from its own citations.
// - Admission and recovery examples are illustrative current commands.
import Icon from "./Icon.astro";
import { RESEARCH_DEMO, formatElapsed } from "../data/research-demo";

const providerMark = (logo: string) => `/providers/${logo}.${["you", "serpapi", "dataforseo"].includes(logo) ? "png" : "svg"}`;

const subject = "Plausible";
const named = RESEARCH_DEMO.results.filter((result) => result.content.includes(subject));
const provenanceRows = named.map((result) => {
  const hosts = new Map<string, { url: string; count: number }>();
  for (const citation of result.citations) {
    if (!citation.url.toLowerCase().includes(subject.toLowerCase())) continue;
    const host = new URL(citation.url).hostname.replace(/^www\./, "");
    const entry = hosts.get(host);
    if (entry) entry.count += 1;
    else hosts.set(host, { url: citation.url, count: 1 });
  }
  const [top] = [...hosts].sort((a, b) => b[1].count - a[1].count);
  return { name: result.shortName, logo: result.logo, host: top ? { host: top[0], ...top[1] } : undefined };
}).filter((row) => row.host);

const cappedPlan: Array<[string, string]> = [
  ["Bounded sources", "admit if they fit"],
  ["Unpriced sources", "skip, not free"],
];

const durations = [...RESEARCH_DEMO.results].sort((a, b) => a.elapsedSeconds - b.elapsedSeconds);
const longest = Math.max(...durations.map((result) => result.elapsedSeconds));
---

<div class="mt-12 grid grid-cols-1 gap-x-8 gap-y-14 border-t border-neutral-950/15 pt-8 lg:grid-cols-3 lg:grid-rows-[auto_auto] lg:gap-y-6">
  <div class="grid gap-6 lg:row-span-2 lg:grid-rows-subgrid">
    <figure class="flex flex-col justify-center rounded border border-neutral-300 bg-white p-5 text-left" aria-label="One finding from a captured run, with the providers that named it and a source each one cited">
      <p class="text-sm font-semibold text-neutral-950">{subject} for small and marketing sites</p>
      <p class="mt-1 font-mono text-xs text-amber-800">named by {provenanceRows.length} of {RESEARCH_DEMO.results.length} providers</p>
      <ul class="mt-4 flex flex-col gap-3">
        {provenanceRows.map((row) => (
          <li class="flex items-center gap-2.5">
            <img src={providerMark(row.logo)} alt="" width="16" height="16" loading="lazy" class="size-4 shrink-0" />
            <span class="text-sm text-neutral-800">{row.name}</span>
            <a href={row.host!.url} target="_blank" rel="noopener noreferrer" class="ml-auto rounded-sm bg-neutral-950/4 px-1.5 py-0.5 font-mono text-xs text-neutral-600 hover:text-amber-800">{row.host!.host}</a>
          </li>
        ))}
      </ul>
    </figure>
    <div>
      <h3 class="text-lg font-semibold text-neutral-950">See where each result came from.</h3>
      <p class="mt-3 text-base/7 text-pretty text-neutral-600 sm:text-sm/6">
        Every finding keeps the provider that returned it and the sources it cited. Open them and judge for yourself — when providers agree, that’s a signal worth checking, not proof they’re right.
      </p>
    </div>
  </div>

  <div class="grid gap-6 lg:row-span-2 lg:grid-rows-subgrid">
    <figure class="flex flex-col justify-center overflow-hidden rounded border border-neutral-950 bg-neutral-950 p-5 text-left font-mono text-xs/[1.7] text-neutral-300" aria-label="Illustrative offline admission with a one-dollar cap">
      <p class="break-words text-amber-100"><span class="text-neutral-500 select-none">$ </span>librarium research "SQLite or Postgres?" <span class="whitespace-nowrap">--deep --only parallel,you</span> <span class="whitespace-nowrap text-amber-300">--max-cost 1 --dry-run</span></p>
      <ul class="mt-3">
        {cappedPlan.map(([profile, estimate]) => (
          <li class="flex justify-between gap-x-3"><span>{profile}</span><span class="text-amber-200">{estimate}</span></li>
        ))}
      </ul>
      <p class="mt-1 flex justify-between gap-x-3"><span class="text-neutral-500">Budget</span><span class="text-amber-100">$1 spending cap</span></p>
      <p class="mt-4 text-neutral-500">Illustrative admission rules. Dry runs make no calls.</p>
    </figure>
    <div>
      <h3 class="text-lg font-semibold text-neutral-950">Decide what can run.</h3>
      <p class="mt-3 text-base/7 text-pretty text-neutral-600 sm:text-sm/6">
        Dry-run a question before anything is paid. Review the selected providers, set a spending ceiling, and check reported costs as results land. Estimates can be missing or wrong — a provider can still bill more than it quoted.
      </p>
    </div>
  </div>

  <div class="grid gap-6 lg:row-span-2 lg:grid-rows-subgrid">
    <figure class="flex flex-col rounded border border-neutral-300 bg-white p-5 text-left" aria-label="Illustrative deep research recovery with historical captured durations">
      <p class="rounded-sm bg-neutral-950 px-2.5 py-1.5 font-mono text-xs/[1.6] break-words text-amber-100">librarium research "Replacing GA4 for an EU SaaS at ~50k visits/month: compare Plausible, Fathom, and Matomo on GDPR posture, funnel analysis, self-hosting, and 3-year cost" <span class="whitespace-nowrap">--deep</span> <span class="whitespace-nowrap text-amber-300">--no-wait</span></p>
      <p class="mt-4 font-mono text-[11px] text-neutral-500">Historical captured times; current commands illustrative</p>
      <ul class="mt-1.5 mb-4 flex flex-col gap-1.5" aria-label="Time each provider took in a captured deep run">
        {durations.map((result) => (
          <li class="grid grid-cols-[5rem_1fr_3.5rem] items-center gap-2 font-mono text-xs text-neutral-600">
            <span class="truncate">{result.shortName}</span>
            <span class="h-1.5 rounded-full bg-neutral-950/5"><span class="block h-full rounded-full bg-amber-500" style={`width: ${Math.max(4, Math.round((result.elapsedSeconds / longest) * 100))}%`}></span></span>
            <span class="text-right text-neutral-500">{formatElapsed(result.elapsedSeconds)}</span>
          </li>
        ))}
      </ul>
      <p class="mt-auto rounded-sm bg-neutral-950 px-2.5 py-1.5 font-mono text-xs/[1.6] text-amber-100">librarium show &lt;run-id&gt; <span class="text-amber-300">--wait</span></p>
      <p class="mt-1.5 font-mono text-xs text-neutral-600"><Icon name="check" class="inline-block text-amber-700" /> Recover the accepted task, not a new submission.</p>
    </figure>
    <div>
      <h3 class="text-lg font-semibold text-neutral-950">Come back to a long-running job.</h3>
      <p class="mt-3 text-base/7 text-pretty text-neutral-600 sm:text-sm/6">
        Deep research can outlast a coffee break. Keep its Run id and recover the accepted handle. JavaScript stores durable tasks; Laravel queues one encrypted job and returns immutable snapshots. Local interruption does not stop upstream billing.
      </p>
    </div>
  </div>
</div>
