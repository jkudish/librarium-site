---
import LogoMark from "./LogoMark.astro";
import Icon from "./Icon.astro";
import { markdownHrefFor } from "../lib/markdown-href";
interface Props { wide?: boolean; }
const { wide = false } = Astro.props;
const markdownHref = markdownHrefFor(Astro.url.pathname);
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => !href.includes("#") && (pathname === href || pathname.startsWith(`${href}/`));
const links = [
  { href: "/agents", label: "Agents & MCP" },
  { href: "/cli", label: "CLI" },
  { href: "/javascript", label: "JavaScript" },
  { href: "/laravel", label: "Laravel" },
  { href: "/#providers", label: "Providers" },
  { href: "/guides", label: "Guides" },
  { href: "/docs", label: "Docs" },
];
---

<header class="border-b border-neutral-950/10">
  <div class:list={["mx-auto flex h-16 items-center justify-between px-6", wide ? "max-w-[1440px] lg:px-10" : "max-w-6xl lg:px-8"]}>
    <a href="/" aria-label="Homepage" class="flex items-center gap-x-2 text-neutral-950">
      <LogoMark id="logo-header" class="size-6 shrink-0" />
      <span class="font-mono text-base font-semibold text-neutral-950">librarium</span>
    </a>
    <nav class="flex items-center gap-x-7" aria-label="Primary navigation">
      <div class="flex items-center gap-x-5 text-sm text-neutral-600 max-lg:hidden lg:gap-x-7">
        {links.map((link) => (
          <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined} class="hover:text-neutral-950 aria-[current=page]:font-medium aria-[current=page]:text-amber-800 aria-[current=page]:underline aria-[current=page]:underline-offset-4">{link.label}</a>
        ))}
      </div>
      <a
        href="https://github.com/jkudish/librarium"
        class="flex items-center gap-x-2 rounded px-3 py-1.5 text-sm font-medium text-neutral-700 ring-1 ring-neutral-950/15 hover:bg-neutral-950/3"
      >
        <Icon name="githubLogo" class="size-4" />
        GitHub
      </a>
      <button
        type="button"
        id="theme-toggle"
        aria-label="Dark theme"
        aria-pressed="false"
        class="flex size-9 cursor-pointer items-center justify-center rounded text-neutral-600 hover:bg-neutral-950/3 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600"
      >
        <Icon name="moon" class="size-4 dark:hidden" />
        <Icon name="sun" class="hidden size-4 dark:block" />
      </button>
      <button
        type="button"
        id="menu-toggle"
        class="relative -mr-2 rounded p-2 text-neutral-600 hover:bg-neutral-950/3 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600 lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="list" class="size-6" />
        <span class="pointer-fine:hidden absolute top-1/2 left-1/2 size-[max(100%,3rem)] -translate-1/2" aria-hidden="true"></span>
      </button>
    </nav>
  </div>
  <div id="mobile-menu" hidden class="border-t border-neutral-950/10 lg:hidden!">
    <nav class="mx-auto flex max-w-6xl flex-col gap-y-1 px-4 py-3" aria-label="Mobile navigation">
      {links.map((link) => (
        <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined} class="rounded-sm px-2 py-2 text-base text-neutral-700 hover:bg-neutral-950/3 hover:text-neutral-950 aria-[current=page]:bg-amber-50 aria-[current=page]:font-medium aria-[current=page]:text-amber-800">{link.label}</a>
      ))}
    </nav>
  </div>
  <div id="page-format-control" class="fixed bottom-5 right-5 z-50">
    <nav aria-label="Page format" class="flex rounded border border-neutral-300 bg-white p-0.5 font-mono text-xs shadow-lg dark:shadow-none">
      <a id="human-view" href={Astro.url.pathname} aria-current="page" class="group flex items-center gap-1.5 rounded-sm px-2 py-1 text-[11px] uppercase sm:px-2.5 sm:py-1.5 sm:text-xs tracking-wide text-neutral-600 hover:text-neutral-950 aria-[current=page]:bg-neutral-950 aria-[current=page]:text-white">
        <span aria-hidden="true" class="flex size-3.5 shrink-0 max-sm:hidden items-center justify-center rounded-full border border-current p-0.5">
          <span class="block size-full rounded-full bg-current opacity-0 transition-opacity group-aria-[current=page]:opacity-100 motion-reduce:transition-none"></span>
        </span>
        Human
      </a>
      <a id="machine-view" href={markdownHref} class="group flex items-center gap-1.5 rounded-sm px-2 py-1 text-[11px] uppercase sm:px-2.5 sm:py-1.5 sm:text-xs tracking-wide text-neutral-600 hover:text-neutral-950 aria-[current=page]:bg-neutral-950 aria-[current=page]:text-white">
        <span aria-hidden="true" class="flex size-3.5 shrink-0 max-sm:hidden items-center justify-center rounded-full border border-current p-0.5">
          <span class="block size-full rounded-full bg-current opacity-0 transition-opacity group-aria-[current=page]:opacity-100 motion-reduce:transition-none"></span>
        </span>
        Machine
      </a>
    </nav>
  </div>
</header>

<section id="machine-panel" hidden class="mx-auto max-w-4xl px-6 pt-10 pb-28 lg:px-8" aria-labelledby="machine-heading">
  <div data-format-slot="machine" class="mb-6 empty:hidden md:hidden"></div>
  <div class="mb-4 flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
    <div class="min-w-0">
      <p id="machine-heading" class="flex items-center gap-2 font-mono text-lg font-medium text-neutral-950"><Icon name="markdownLogo" class="size-5 text-neutral-500" />Markdown</p>
      <p class="mt-1 font-mono text-xs text-neutral-500"><span class="break-all">{markdownHref}</span><span id="machine-meta"></span></p>
    </div>
    <div class="flex shrink-0 items-center gap-2">
      <button
        type="button"
        id="machine-copy"
        data-copy-state="idle"
        disabled
        class="group flex min-h-9 cursor-pointer items-center gap-2 rounded px-3 py-1.5 text-sm font-medium text-neutral-700 ring-1 ring-neutral-950/15 hover:bg-neutral-950/3 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600 disabled:cursor-not-allowed disabled:opacity-50 data-[copy-state=success]:text-amber-800"
      >
        <Icon name="copy" class="size-4 group-data-[copy-state=success]:hidden" />
        <Icon name="check" class="hidden size-4 group-data-[copy-state=success]:block" />
        <span id="machine-copy-label">Copy Markdown</span>
      </button>
      <a href={markdownHref} class="flex min-h-9 items-center gap-1.5 rounded px-3 py-1.5 text-sm text-neutral-600 hover:text-neutral-950">Open raw <Icon name="arrowUpRight" class="size-3.5" /></a>
    </div>
  </div>
  <p id="machine-status" role="status" class="text-sm text-neutral-600 empty:hidden"></p>
  <p id="machine-copy-status" aria-live="polite" class="sr-only"></p>
  <pre id="machine-content" tabindex="0" aria-label="Page Markdown" class="machine-markdown rounded border border-neutral-200 bg-neutral-50 px-5 py-5 font-mono text-[13px]/6 text-neutral-800 empty:hidden sm:text-sm/7 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600 sm:px-7 sm:py-6"></pre>
</section>

<style>
  :global(html[data-page-view="machine"] header ~ *:not(#machine-panel)) {
    display: none !important;
  }
  .machine-markdown {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    tab-size: 2;
    font-variant-ligatures: none;
  }
</style>

<script>
  // Mobile browser chrome and pinch zoom can make the visible viewport smaller
  // than the layout viewport used by position: fixed.
  const formatControl = document.getElementById("page-format-control");
  const viewport = window.visualViewport;
  function positionFormatControl() {
    if (!formatControl || !viewport) return;
    if (formatControl.dataset.placement === "slot") {
      formatControl.style.removeProperty("right");
      formatControl.style.removeProperty("bottom");
      return;
    }
    const rightInset = Math.max(0, window.innerWidth - viewport.offsetLeft - viewport.width);
    const gap = window.innerWidth < 640 ? "0.75rem" : "1.25rem";
    formatControl.style.right = `calc(${rightInset}px + ${gap} + env(safe-area-inset-right))`;
    const inset = Math.max(0, window.innerHeight - viewport.offsetTop - viewport.height);
    formatControl.style.bottom = `calc(${inset}px + ${gap} + env(safe-area-inset-bottom))`;
  }
  viewport?.addEventListener("resize", positionFormatControl);
  viewport?.addEventListener("scroll", positionFormatControl);
  window.addEventListener("resize", positionFormatControl);
  // Phones: the control sits in the footer (or atop the Markdown view, which
  // hides the footer) instead of floating over content. Wider screens keep
  // the fixed bottom-right dock. The same element moves, so listeners survive.
  const phone = window.matchMedia("(max-width: 767px)");
  const home = document.createComment("page-format-control");
  formatControl?.before(home);
  // Moving a node drops focus, so remember which control had it and restore
  // focus after the move, once the destination is visible.
  function placeFormatControl(focused: Element | null = document.activeElement) {
    if (!formatControl) return;
    const restore = focused instanceof HTMLElement && formatControl.contains(focused) ? focused : null;
    const machineMode = document.documentElement.dataset.pageView === "machine";
    const slot = phone.matches ? document.querySelector<HTMLElement>(`[data-format-slot="${machineMode ? "machine" : "footer"}"]`) : null;
    if (slot) {
      if (formatControl.parentElement !== slot) slot.append(formatControl);
      formatControl.dataset.placement = "slot";
    } else {
      if (formatControl.previousSibling !== home) home.after(formatControl);
      delete formatControl.dataset.placement;
    }
    positionFormatControl();
    if (restore && document.activeElement !== restore) restore.focus({ preventScroll: true });
  }
  // A breakpoint move happens after the browser may already have blurred the
  // control (focus falls to <body>). Keep the last focused control only while
  // focus is still on <body>; any real departure clears it.
  let focusedControl: HTMLElement | null = null;
  formatControl?.addEventListener("focusin", (event) => { focusedControl = event.target as HTMLElement; });
  document.addEventListener("focusin", (event) => {
    if (!formatControl?.contains(event.target as Node)) focusedControl = null;
  });
  document.addEventListener("pointerdown", (event) => {
    if (!formatControl?.contains(event.target as Node)) focusedControl = null;
  });
  window.addEventListener("blur", () => { focusedControl = null; });
  phone.addEventListener("change", () => {
    const active = document.activeElement;
    const lost = active === null || active === document.body;
    placeFormatControl(lost ? focusedControl : active);
  });
  placeFormatControl();
  const human = document.querySelector<HTMLAnchorElement>("#human-view");
  const machine = document.querySelector<HTMLAnchorElement>("#machine-view");
  const panel = document.querySelector<HTMLElement>("#machine-panel");
  const content = document.querySelector<HTMLElement>("#machine-content");
  const status = document.querySelector<HTMLElement>("#machine-status");
  const meta = document.querySelector<HTMLElement>("#machine-meta");
  const copyButton = document.querySelector<HTMLButtonElement>("#machine-copy");
  const copyLabel = document.querySelector<HTMLElement>("#machine-copy-label");
  const copyStatus = document.querySelector<HTMLElement>("#machine-copy-status");
  let request: AbortController | undefined;
  let copyReset: number | undefined;
  function setCopyState(state: "idle" | "success" | "error") {
    if (!copyButton || !copyLabel || !copyStatus) return;
    window.clearTimeout(copyReset);
    copyButton.dataset.copyState = state;
    copyLabel.textContent = state === "success" ? "Copied" : state === "error" ? "Press Ctrl+C / ⌘C" : "Copy Markdown";
    copyStatus.textContent = state === "success"
      ? "Markdown copied to clipboard."
      : state === "error" ? "Clipboard unavailable. The Markdown is selected; press Control C or Command C to copy it." : "";
    if (state !== "idle") copyReset = window.setTimeout(() => setCopyState("idle"), state === "success" ? 2000 : 5000);
  }
  // Fallback when the Clipboard API is missing or denied (insecure origin,
  // permissions): select the text so the reader can copy it with the keyboard.
  function selectMarkdown() {
    if (!content) return;
    const range = document.createRange();
    range.selectNodeContents(content);
    const selection = window.getSelection();
    selection?.removeAllRanges();
    selection?.addRange(range);
    content.focus({ preventScroll: true });
  }
  copyButton?.addEventListener("click", async () => {
    const text = content?.textContent ?? "";
    if (!text) return;
    try {
      if (!navigator.clipboard?.writeText) throw new Error("Clipboard API unavailable");
      await navigator.clipboard.writeText(text);
      setCopyState("success");
    } catch {
      selectMarkdown();
      setCopyState("error");
    }
  });
  human?.addEventListener("click", (event) => {
    event.preventDefault();
    request?.abort();
    delete document.documentElement.dataset.pageView;
    placeFormatControl(human);
    if (panel) panel.hidden = true;
    human.setAttribute("aria-current", "page");
    machine?.removeAttribute("aria-current");
  });
  machine?.addEventListener("click", async (event) => {
    event.preventDefault();
    if (!panel || !content || !status) return;
    request?.abort();
    const current = new AbortController();
    request = current;
    document.documentElement.dataset.pageView = "machine";
    window.scrollTo({ top: 0, behavior: "instant" });
    panel.hidden = false;
    placeFormatControl(machine);
    machine.setAttribute("aria-current", "page");
    human?.removeAttribute("aria-current");
    content.textContent = "";
    if (meta) meta.textContent = "";
    if (copyButton) copyButton.disabled = true;
    setCopyState("idle");
    status.textContent = "Loading Markdown…";
    try {
      const response = await fetch(machine.href, { signal: current.signal });
      if (!response.ok) throw new Error("Markdown unavailable");
      const text = await response.text();
      if (current.signal.aborted) return;
      content.textContent = text;
      const lines = text.trimEnd().split("\n").length;
      const kilobytes = new Blob([text]).size / 1024;
      if (meta) meta.textContent = ` · ${lines.toLocaleString()} lines · ${kilobytes < 10 ? kilobytes.toFixed(1) : Math.round(kilobytes)} KB`;
      if (copyButton) copyButton.disabled = false;
      status.textContent = "";
    } catch {
      if (!current.signal.aborted) status.textContent = "Could not load Markdown. Try again or open the raw Markdown link.";
    }
  });
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const isOpen = !menu?.hidden;
    if (menu) menu.hidden = isOpen;
    toggle.setAttribute("aria-expanded", String(!isOpen));
  });
  const themeToggle = document.querySelector<HTMLButtonElement>("#theme-toggle");
  const syncThemeToggle = () => {
    const dark = document.documentElement.dataset.theme === "dark";
    themeToggle?.setAttribute("aria-pressed", String(dark));
  };
  // Every theme change goes through <html data-theme>: the toggle above,
  // and the OS-preference listener in Base.astro. Watching the attribute
  // keeps the accessible state correct no matter which path changed it.
  new MutationObserver(syncThemeToggle).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["data-theme"],
  });
  themeToggle?.addEventListener("click", () => {
    const root = document.documentElement;
    const dark = root.dataset.theme !== "dark";
    root.dataset.theme = dark ? "dark" : "light";
    try { localStorage.setItem("librarium-theme", dark ? "dark" : "light"); } catch { /* storage unavailable */ }
  });
  syncThemeToggle();
</script>
