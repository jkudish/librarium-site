---
interface NavItem {
  slug: string;
  title: string;
  href: string;
}

interface Props {
  navItems: NavItem[];
  currentSlug: string;
}

const { navItems, currentSlug } = Astro.props;
const groups = [
  { title: "Getting started", slugs: ["", "configuration", "upgrading-to-v2"] },
  { title: "Research", slugs: ["providers", "groups-and-modes", "commands"] },
  { title: "Build with Librarium", slugs: ["library", "using-with-agents", "custom-providers", "testing"] },
  { title: "Reference", slugs: ["request-and-retry", "output-formats", "maintenance"] },
];
const labels: Record<string, string> = {
  "": "Introduction", "providers": "Providers & profiles", "groups-and-modes": "Groups & modes",
  "library": "Library API", "using-with-agents": "Agent workflows", "request-and-retry": "Requests & retries",
};
---

{groups.map((group) => (
  <div class="docs-nav-group">
    <p class="mb-3 text-base font-medium text-neutral-950 sm:text-sm">{group.title}</p>
    <ul role="list" class="border-l border-neutral-200">
    {group.slugs.flatMap((slug) => navItems.filter((item) => item.slug === slug)).map((item) => {
      const isActive =
        item.slug === currentSlug ||
        (item.slug === "" && currentSlug === "index");
      return (
        <li>
          <a
            href={item.href}
            class:list={[
              "-ml-px block border-l-2 px-4 py-2 text-base sm:py-1.5 sm:text-sm",
              isActive
                ? "border-amber-700 bg-amber-50/50 text-amber-800"
                : "border-transparent text-neutral-600 hover:border-neutral-300 hover:text-neutral-950",
            ]}
            aria-current={isActive ? "page" : undefined}
          >
            {labels[item.slug] ?? item.title}
          </a>
        </li>
      );
    })}
    </ul>
  </div>
))}
