---
import "../styles/global.css";
import {
  NODE_FLOOR,
  PRODUCT_VERSION,
  PROFILE_COUNT,
  PROVIDER_COUNT,
} from "../data/product";

interface Props {
  title: string;
  description?: string;
  robots?: string;
  includeSoftwareMetadata?: boolean;
}

const {
  title,
  description = "Librarium fans one research query out to search engines, AI-grounded answers, and deep-research APIs in parallel, then merges everything into one structured output.",
  robots,
  includeSoftwareMetadata = true,
} = Astro.props;

const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : undefined;
const productDescription = "The meta harness for research queries.";

const jsonLd = JSON.stringify([
  ...(includeSoftwareMetadata ? [{
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "librarium",
    description: productDescription,
    applicationCategory: "DeveloperApplication",
    operatingSystem: "macOS, Linux, Windows",
    softwareVersion: PRODUCT_VERSION,
    runtimePlatform: `Node.js ${NODE_FLOOR}+`,
    featureList: [
      `${PROVIDER_COUNT} built-in providers and ${PROFILE_COUNT} public profiles`,
      "Four built-in workflows: quick, deep, visibility, and all",
      "CLI, MCP server, agent skill, and Worker-safe package boundaries",
      "Provider, profile, collection, and source provenance",
    ],
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    license: "https://github.com/jkudish/librarium/blob/main/LICENSE",
    url: Astro.site?.href,
    sameAs: ["https://github.com/jkudish/librarium"],
    author: { "@type": "Person", name: "Joey Kudish", url: "https://jkudish.com" },
  }] : []),
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "librarium",
    url: Astro.site?.href,
  },
]);
---

<!doctype html>
<html lang="en" class="antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Theme default follows the OS; a stored choice from the header toggle
      // overrides it. Runs before first paint to avoid a flash.
      (() => {
        const root = document.documentElement;
        const media = window.matchMedia("(prefers-color-scheme: dark)");
        const storedChoice = () => {
          try { return localStorage.getItem("librarium-theme"); } catch { return null; }
        };
        const apply = (dark) => { root.dataset.theme = dark ? "dark" : "light"; };
        const stored = storedChoice();
        apply(stored === "dark" || stored === "light" ? stored === "dark" : media.matches);
        media.addEventListener("change", (event) => {
          const current = storedChoice();
          if (current !== "dark" && current !== "light") apply(event.matches);
        });
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL("/og.jpg", Astro.site ?? Astro.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Librarium: the meta harness for research queries" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content="librarium" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/og.jpg", Astro.site ?? Astro.url).href} />
    <meta name="twitter:image:alt" content="Librarium: the meta harness for research queries" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline type="application/ld+json" set:html={jsonLd} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-white font-sans text-neutral-600">
    <div class="isolate">
      <slot />
    </div>
  </body>
</html>
