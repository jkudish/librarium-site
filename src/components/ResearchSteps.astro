---
import CommandText from "./CommandText.astro";
import Icon from "./Icon.astro";
import { RESEARCH_COMMANDS } from "../data/research-commands";
interface Props { platform?: keyof typeof RESEARCH_COMMANDS }
const { platform = "cli" } = Astro.props;
const commands = RESEARCH_COMMANDS[platform];
---
<div class="rounded-lg border border-neutral-200 bg-white p-5" data-research-steps={platform}>
  <p class="text-sm font-medium text-neutral-950">{commands.requirement}</p>
  <ol class="mt-4 space-y-4">
    {([
      ["Install", commands.install],
      [platform === "laravel" ? "Publish configuration" : "Configure sources", commands.setup],
      ["Preview offline", commands.preview],
      ["Research when ready", commands.research],
    ] as const).map(([label, command]) => <li>
      <div class="mb-1 flex items-center justify-between gap-2">
        <p class="text-xs font-medium text-neutral-500">{label}</p>
        <button type="button" class="group cursor-pointer rounded p-1 text-neutral-500 hover:text-amber-700 focus-visible:outline-2 focus-visible:outline-amber-700" data-code-copy data-copy={command} data-copy-state="idle" aria-label={`Copy ${label} command`}>
          <Icon name="copy" class="size-3.5 group-data-[copy-state=success]:hidden" />
          <Icon name="check" class="hidden size-3.5 group-data-[copy-state=success]:block" />
        </button>
      </div>
      <code class="block rounded-md bg-neutral-950 p-3 font-mono text-xs/6 text-amber-100"><CommandText command={command} /></code>
    </li>)}
  </ol>
  <p class="mt-4 text-sm/6 text-neutral-600">Configure your source credentials first. The preview makes no calls; research uses paid services.</p>
  {platform === "javascript" && <p class="mt-2 text-sm/6 text-neutral-600">Create the client shown below. For the setup wizard, install the <a class="text-amber-700 underline" href="/cli">CLI</a> too.</p>}
</div>

<script>
  import "../scripts/copy-buttons";
</script>
