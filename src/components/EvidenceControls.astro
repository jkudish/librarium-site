---
import CodePanel from "./CodePanel.astro";
import { RESEARCH_DEMO, PROVIDER_COMPARISON, formatElapsed } from "../data/research-demo";

interface Props { agreement?: boolean }
const { agreement = false } = Astro.props;
const subject = "Plausible";
const namedCount = PROVIDER_COMPARISON.filter((row) => row.named.includes(subject)).length;
const durations = [...RESEARCH_DEMO.results].sort((a, b) => a.elapsedSeconds - b.elapsedSeconds);
const longest = Math.max(...durations.map((result) => result.elapsedSeconds));
const preview = `librarium research "${RESEARCH_DEMO.query}" --deep --only parallel,you --max-cost 1 --dry-run`;
const resume = `librarium research "${RESEARCH_DEMO.query}" --deep --no-wait\nlibrarium show <run-id> --wait`;
---

{agreement ? (
  <article data-evidence-card="agreement">
    <h3 class="text-lg font-medium text-neutral-950">Check where providers agree.</h3>
    <p class="mt-2 text-base/6 text-neutral-600 sm:text-sm/6">Each answer keeps its provider and cited pages. Agreement is a reason to check the evidence, not proof the answer is right.</p>
    <figure class="mt-4 rounded border border-neutral-300 bg-white p-5" aria-label="Plausible mentions across all five captured excerpts">
      <p class="text-lg font-medium text-neutral-950">{subject}</p>
      <p class="mt-1 text-base text-amber-800 sm:text-sm">named in {namedCount} of {PROVIDER_COMPARISON.length} provider excerpts</p>
      <ul role="list" class="mt-4 divide-y divide-neutral-200">
        {PROVIDER_COMPARISON.map((row) => (
          <li class="flex items-center justify-between gap-3 py-2 text-base text-neutral-700 sm:text-sm"><span>{row.provider}</span><span class={row.named.includes(subject) ? "text-amber-800" : "text-neutral-500"}>{row.named.includes(subject) ? "Named" : "Not in excerpt"}</span></li>
        ))}
      </ul>
      <figcaption class="mt-3 text-base/6 text-neutral-500 sm:text-sm/6">Only the displayed excerpts are compared. Open the Answers tab to read their wording and citations.</figcaption>
    </figure>
  </article>
) : (
  <div class="mt-10 grid items-start gap-10 border-t border-neutral-300 pt-8 lg:grid-cols-2">
    <article data-evidence-card="preview">
      <h3 class="text-xl font-medium text-neutral-950">Preview before spending.</h3>
      <p class="mt-3 text-base/7 text-neutral-600">Dry-run your question without provider calls. Review the selected sources and estimates, then set a spending ceiling before starting the research.</p>
      <figure class="mt-5" aria-label="Illustrative offline preview with a one-dollar budget">
        <CodePanel label="Offline preview" code={preview} lang="bash" />
        <figcaption class="mt-3 text-base/6 text-neutral-600 sm:text-sm/6">Illustrative command. With a cap, sources with no price estimate are skipped; priced sources run only if their estimates fit the remaining budget.</figcaption>
      </figure>
      <p class="mt-3 text-base/6 text-neutral-600 sm:text-sm/6">Estimates and spending caps are not billing guarantees. <a href="/docs/costs-and-limits" class="text-amber-800 underline underline-offset-4 hover:text-amber-600">Costs and limits →</a></p>
    </article>
    <article data-evidence-card="recovery">
      <h3 class="text-xl font-medium text-neutral-950">Come back to long-running research.</h3>
      <p class="mt-3 text-base/7 text-neutral-600">Keep the Run ID and resume the same research rather than submitting again. JavaScript stores the work locally; Laravel can run it in an encrypted queue job.</p>
      <figure class="mt-5 rounded border border-neutral-300 bg-white p-5" aria-label="Historical captured durations, followed by illustrative recovery commands">
        <figcaption class="text-base/6 text-neutral-600 sm:text-sm/6">Historical durations from the September 18 capture</figcaption>
        <ul role="list" class="mt-4 flex flex-col gap-3" aria-label="Historical provider durations">
          {durations.map((result) => (
            <li class="grid grid-cols-[6rem_1fr_4rem] items-center gap-3 text-sm text-neutral-600">
              <span>{result.shortName}</span><span class="h-1.5 rounded-full bg-neutral-100"><span class="duration-bar" style={`--duration-width: ${Math.max(4, Math.round(result.elapsedSeconds / longest * 100))}%`}></span></span><span class="text-right font-mono tabular-nums">{formatElapsed(result.elapsedSeconds)}</span>
            </li>
          ))}
        </ul>
        <CodePanel class="mt-5" label="Illustrative commands" code={resume} lang="bash" />
      </figure>
    </article>
  </div>
)}

<style>
  [data-evidence-card] { min-width: 0; }
  .duration-bar { display: block; height: 100%; width: var(--duration-width); border-radius: 9999px; background: var(--color-amber-500); }
</style>
