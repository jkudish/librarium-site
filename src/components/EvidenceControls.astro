---
import InterfaceTabs from "./InterfaceTabs.astro";
import { RESEARCH_DEMO, PROVIDER_COMPARISON, formatElapsed } from "../data/research-demo";

interface Props { agreement?: boolean }
const { agreement = false } = Astro.props;
const subject = "Plausible";
const namedCount = PROVIDER_COMPARISON.filter((row) => row.named.includes(subject)).length;
const durations = [...RESEARCH_DEMO.results].sort((a, b) => a.elapsedSeconds - b.elapsedSeconds);
const longest = Math.max(...durations.map((result) => result.elapsedSeconds));
const q = RESEARCH_DEMO.query;
const previewExamples = [
  { id: "agent", label: "Agent", panelLabel: "Ask your agent", lang: "text" as const, code: `Preview a $1 deep research run on "${q}" with Parallel and You.com. Show me the estimates; don't run it yet.` },
  { id: "cli", label: "CLI", panelLabel: "Terminal", lang: "bash" as const, code: `librarium research "${q}" --deep --only parallel,you --max-cost 1 --dry-run` },
  { id: "javascript", label: "JavaScript", panelLabel: "JavaScript", lang: "ts" as const, code: `await librarium.research('${q}', {\n  depth: 'deep',\n  only: ['parallel', 'you'],\n  maxCost: '1.00',\n  dryRun: true,\n});` },
  { id: "laravel", label: "Laravel", panelLabel: "Laravel", lang: "php" as const, code: `Librarium::research('${q}')\n    ->deep()\n    ->only(['parallel', 'you'])\n    ->maxCost('1.00')\n    ->dryRun();` },
];
const resumeExamples = [
  { id: "agent", label: "Agent", panelLabel: "Ask your agent", lang: "text" as const, code: `Start deep research on "${q}" without waiting, and give me the Run ID. I'll ask for the results later.` },
  { id: "cli", label: "CLI", panelLabel: "Terminal", lang: "bash" as const, code: `librarium research "${q}" --deep --no-wait\nlibrarium show <run-id> --wait` },
  { id: "javascript", label: "JavaScript", panelLabel: "JavaScript", lang: "ts" as const, code: `const started = await librarium.research('${q}', {\n  depth: 'deep',\n  wait: false,\n});\nconst later = await librarium.get(started.id, { wait: true });` },
  { id: "laravel", label: "Laravel", panelLabel: "Laravel", lang: "php" as const, code: `$queued = Librarium::research('${q}')\n    ->deep()\n    ->queue();\n\n$run = Librarium::find($queued->id())?->refresh();` },
];
---

{agreement ? (
  <article data-evidence-card="agreement">
    <h3 class="text-lg font-medium text-neutral-950">Check where providers agree.</h3>
    <p class="mt-2 text-base/6 text-neutral-600 sm:text-sm/6">Each answer keeps its provider and cited pages. Agreement is a reason to check the evidence, not proof the answer is right.</p>
    <figure class="mt-4 rounded border border-neutral-300 bg-white p-5" aria-label="Plausible mentions across all five captured excerpts">
      <p class="text-lg font-medium text-neutral-950">{subject}</p>
      <p class="mt-1 text-base text-amber-800 sm:text-sm">named in {namedCount} of {PROVIDER_COMPARISON.length} provider excerpts</p>
      <ul role="list" class="mt-4 divide-y divide-neutral-200">
        {PROVIDER_COMPARISON.map((row) => (
          <li class="flex items-center justify-between gap-3 py-2 text-base text-neutral-700 sm:text-sm"><span>{row.provider}</span><span class={row.named.includes(subject) ? "text-amber-800" : "text-neutral-500"}>{row.named.includes(subject) ? "Named" : "Not in excerpt"}</span></li>
        ))}
      </ul>
      <figcaption class="mt-3 text-base/6 text-neutral-500 sm:text-sm/6">Only the displayed excerpts are compared. Open the Answers tab to read their wording and citations.</figcaption>
    </figure>
  </article>
) : (
  <div class="mt-10 grid items-start gap-10 border-t border-neutral-300 pt-8 lg:grid-cols-2">
    <article data-evidence-card="preview">
      <h3 class="text-xl font-medium text-neutral-950">See what it will cost before it runs.</h3>
      <p class="mt-3 text-base/7 text-neutral-600">Preview any question for free: see which sources would run and what each would cost, before anything is called. <a href="/docs/costs-and-limits" class="text-amber-800 underline underline-offset-4 hover:text-amber-600">How budgets work →</a></p>
      <InterfaceTabs class="mt-5" id="preview-example" label="Preview example" examples={previewExamples} />
    </article>
    <article data-evidence-card="recovery">
      <h3 class="text-xl font-medium text-neutral-950">Come back to long-running research.</h3>
      <p class="mt-3 text-base/7 text-neutral-600">Deep research can take minutes. Start it, walk away, and pick it up later by its Run ID. <a href="/docs/request-and-retry" class="text-amber-800 underline underline-offset-4 hover:text-amber-600">How recovery works →</a></p>
      <figure class="mt-5 rounded border border-neutral-300 bg-white p-5" aria-label="Provider durations from the September 18, 2026 capture">
        <ul role="list" class="flex flex-col gap-3" aria-label="Historical provider durations">
          {durations.map((result) => (
            <li class="grid grid-cols-[6rem_1fr_4rem] items-center gap-3 text-sm text-neutral-600">
              <span>{result.shortName}</span><span class="h-1.5 rounded-full bg-neutral-100"><span class="duration-bar" style={`--duration-width: ${Math.max(4, Math.round(result.elapsedSeconds / longest * 100))}%`}></span></span><span class="text-right font-mono tabular-nums">{formatElapsed(result.elapsedSeconds)}</span>
            </li>
          ))}
        </ul>
      </figure>
      <InterfaceTabs class="mt-5" id="resume-example" label="Resume example" examples={resumeExamples} />
    </article>
  </div>
)}

<style>
  [data-evidence-card] { min-width: 0; }
  .duration-bar { display: block; height: 100%; width: var(--duration-width); border-radius: 9999px; background: var(--color-amber-500); }
</style>
