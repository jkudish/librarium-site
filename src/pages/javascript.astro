---
// Dedicated product page for /javascript. src/content/pages/javascript.md
// stays the source of truth for the agent-readable twin at /javascript.md
// (served by [...page].md.ts and bundled into the llms files). Every code
// example below is read from that file's fenced blocks, so the page and its
// Markdown cannot drift apart.
//
// JSON examples are illustrative, not live provider receipts.
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import ProductHero from "../components/ProductHero.astro";
import CopyPageButton from "../components/CopyPageButton.astro";
import CodePanel from "../components/CodePanel.astro";
import TerminalBlock from "../components/TerminalBlock.astro";
import ResearchSteps from "../components/ResearchSteps.astro";
import { inline } from "../lib/inline-markup";
import { fencedBlocks, pickBlock } from "../lib/markdown-code";

const entry = await getEntry("pages", "javascript");
if (!entry) throw new Error("src/content/pages/javascript.md is missing");
const { title, description, ctaHref, ctaLabel } = entry.data;
const markdownHref = "/javascript.md";
const source = "src/content/pages/javascript.md";
const blocks = fencedBlocks(entry.body ?? "");
const planSnippet = pickBlock(blocks, "ts", "const plan =", source);
const validateCode = pickBlock(blocks, "ts", "RunSchema.parse(payload)", source);
const responseJson = pickBlock(blocks, "json", '"spec": "librarium.run/1"', source);

const boundaries = [
  {
    path: "librarium",
    lead: "Ready-to-use Node client.",
    body: "Construct a client with v3 configuration, filesystem storage, research, recovery, and summarization. Import does not make provider calls.",
    code: "import { createLibrarium, RunSchema } from 'librarium';",
  },
  {
    path: "librarium/core",
    lead: "Runtime-neutral client.",
    body: "Workers and browsers: supply config and credentials explicitly. Memory is the default store; supply persistent storage that rejects stale writes to recover across processes.",
    code: "import { createLibrarium, MemoryRunStore } from 'librarium/core';",
  },
  {
    path: "librarium/node",
    lead: "Host-specific concerns.",
    body: "The same client, filesystem RunStore, and v3 config loading/saving. Custom source modules are trusted application code.",
    code: "import { createLibrarium, FilesystemRunStore } from 'librarium/node';",
  },
];

// Field notes for the illustrative response, keyed to the contract.
const fields = [
  { name: "status", note: "`planned`, `running`, `done`, `partial`, or `failed`. Keep partial and failed results visible." },
  { name: "results[].source · observation", note: "Source name and `api` or `surface` observation. AI answer engines run when chosen by name." },
  { name: "results[].provenance", note: "Provider, variant, model, and the service used to retrieve the answer. Descriptive, not a confidence score." },
  { name: "results[].citations", note: "URLs and optional titles attached to the source that returned them. Validate before rendering." },
  { name: "cost", note: "Estimated and provider-reported spending, kept separately." },
  { name: "skipped · error", note: "Admission skips and safe per-source failures remain distinct from answers." },
];

const sectionHeading = "max-w-[22ch] text-3xl font-medium tracking-tight text-balance text-neutral-950 sm:text-5xl";
---

<Base title={`${title} | Librarium`} description={description} includeSoftwareMetadata={false}>
  <Header />
  <main>
    <ProductHero title={title} description={description} ctaHref={ctaHref} ctaLabel={ctaLabel} markdownHref={markdownHref} secondary={{ href: "#plan", label: "See it in code" }}>
      <div class="rounded-lg border border-neutral-200 bg-white p-5">
        <div class="flex items-center gap-3">
          <img src="/languages/typescript.svg" alt="" width="24" height="24" class="size-6" />
          <p class="text-sm font-medium text-neutral-950">Typed client · JavaScript / TypeScript</p>
        </div>
        <div class="mt-4"><ResearchSteps platform="javascript" /></div>
        <ul class="mt-4 space-y-2 text-sm/6 text-neutral-600" aria-label="Import boundaries">
          {boundaries.map((boundary) => (
            <li class="flex items-baseline gap-2"><code class="shrink-0 font-mono text-[0.85em] text-neutral-950">{boundary.path}</code><span class="text-neutral-400" aria-hidden="true">·</span><span>{boundary.lead}</span></li>
          ))}
        </ul>
      </div>
    </ProductHero>

    <!-- Planning example with captured output. -->
    <section id="plan" class="scroll-mt-6 py-16 sm:py-24" aria-labelledby="plan-heading">
      <div class="mx-auto max-w-6xl px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-x-12 gap-y-6 lg:grid-cols-2">
          <div class="min-w-0">
            <p class="font-mono text-xs tracking-wide text-amber-700 uppercase">Plan</p>
            <h2 id="plan-heading" class={`mt-3 ${sectionHeading}`}>Preview, then research.</h2>
          </div>
          <div class="min-w-0 lg:pt-8">
            <p class="text-base/7 text-pretty text-neutral-600" set:html={inline("`research(question, { dryRun: true })` previews source selection and admission offline. It makes no provider call and stores nothing.")} />
            <p class="mt-4 text-base/7 text-pretty text-neutral-600" set:html={inline("Use the same question and options without `dryRun` to research. The Run is saved before starting; `get(id)` picks up in-progress research instead of submitting again.")} />
            <div class="mt-6 rounded-lg border border-neutral-200 bg-neutral-50 p-5">
              <p class="text-sm font-semibold text-neutral-950">One client for research and recovery.</p>
              <p class="mt-2 text-sm/6 text-pretty text-neutral-600" set:html={inline("The [CLI](/cli) and [MCP server](/agents) use the same client. Choose the Node or runtime-neutral boundary for your application.")} />
            </div>
          </div>
        </div>
        <CodePanel class="mt-10" label="plan.ts" lang="ts" code={planSnippet} />
        <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)]">
          <div class="min-w-0">
            <TerminalBlock
              title="Output"
              kind="illustrative"
              badge="Illustrative"
              lines={[
                { out: "planned [ 'exa', 'kagi' ]" },
              ]}
              caption="Preview fields from an example configuration."
            />
          </div>
          <div class="min-w-0">
            <div class="rounded-lg border border-neutral-200 bg-white p-5">
              <p class="text-sm font-semibold text-neutral-950">What the plan holds</p>
              <ul class="mt-3 space-y-2 text-sm/6 text-pretty text-neutral-600">
                <li set:html={inline("`plan.results`: admitted sources and variants.")} />
                <li set:html={inline("`plan.skipped`: sources left out and why.")} />
                <li set:html={inline("`plan.cost`: estimated spending and your limit.")} />
                <li set:html={inline("The public shape is `librarium.run/1`; private execution state is separate.")} />
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Result shape. -->
    <section id="result" class="scroll-mt-6 border-t border-neutral-200 bg-[#faf9f6] py-16 sm:py-24" aria-labelledby="result-heading">
      <div class="mx-auto max-w-6xl px-6 lg:px-8">
        <h2 id="result-heading" class={sectionHeading}>Read the shared Run.</h2>
        <p class="mt-5 max-w-[62ch] text-lg/8 text-pretty text-neutral-600">Validate a response at your application boundary, then render each result with its own citations. Keep raw content out of HTML sinks.</p>
        <CodePanel class="mt-12" label="evidence.ts" lang="ts" code={validateCode} />
        <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)]">
          <div class="min-w-0">
            <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
              <p class="text-sm font-medium text-neutral-950">What a Run looks like</p>
              <span class="rounded-sm border border-neutral-200 bg-white px-1.5 py-0.5 font-mono text-[11px] tracking-wide text-neutral-500 uppercase">Illustrative</span>
            </div>
            <CodePanel label="Run" lang="json" code={responseJson} />
            <p class="mt-3 text-xs/5 text-pretty text-neutral-500" set:html={inline("Empty preview validated by `RunSchema`.")} />
          </div>
          <dl class="self-start rounded-lg border border-neutral-200 bg-white lg:mt-9">
            {fields.map((field, index) => (
              <div class:list={["px-5 py-4", index > 0 && "border-t border-neutral-200"]}>
                <dt class="font-mono text-sm font-semibold text-neutral-950">{field.name}</dt>
                <dd class="mt-1 text-sm/6 text-pretty text-neutral-600" set:html={inline(field.note)} />
              </div>
            ))}
          </dl>
        </div>
        <p class="mt-10 max-w-[72ch] text-base/7 text-pretty text-neutral-600">Your app owns authentication, tenant boundaries, persistence, retention, and the interface around the evidence. JavaScript and PHP share the public Run format, while each executes research in its own runtime.</p>
        <p class="mt-4 text-sm/6 text-neutral-600" set:html={inline("See [costs and limits](/docs/costs-and-limits) for estimates and billing caveats.")} />
      </div>
    </section>

    <!-- Import boundaries. -->
    <section class="py-16 sm:py-24" aria-labelledby="boundaries-heading">
      <div class="mx-auto max-w-6xl px-6 lg:px-8">
        <h2 id="boundaries-heading" class={sectionHeading}>Workers and custom stores.</h2>
        <p class="mt-5 max-w-[62ch] text-lg/8 text-pretty text-neutral-600">Core is runtime-neutral. Root and Node provide filesystem and host configuration. Import the boundary your runtime needs.</p>
        <ul class="mt-12 grid grid-cols-1 gap-6 lg:grid-cols-3">
          {boundaries.map((boundary) => (
            <li class="flex min-w-0 flex-col rounded-lg border border-neutral-200 bg-white p-6">
              <p class="font-mono text-base font-semibold text-neutral-950">{boundary.path}</p>
              <p class="mt-1 text-sm text-neutral-500">{boundary.lead}</p>
              <p class="mt-3 mb-5 text-base/7 text-pretty text-neutral-600 sm:text-sm/6" set:html={inline(boundary.body)} />
              <CodePanel class="mt-auto" label="Import" lang="ts" code={boundary.code} />
            </li>
          ))}
        </ul>
        <p class="mt-8 text-base/7 text-pretty text-neutral-600 sm:text-sm/6" set:html={inline("The npm package is v2, its configuration is version 3, and its public Run format is `librarium.run/1`. These version numbers describe different contracts. See [CLI installation](/docs#install) and the [JavaScript API docs](/docs/library).")} />
      </div>
    </section>

    <!-- Distinctions and next steps. -->
    <section class="border-y border-neutral-300 bg-[#eeeae0] py-16 sm:py-24" aria-labelledby="distinctions-heading">
      <div class="mx-auto max-w-6xl px-6 lg:px-8">
        <h2 id="distinctions-heading" class={sectionHeading}>Preserve the distinctions that matter.</h2>
        <p class="mt-5 max-w-[62ch] text-lg/8 text-pretty text-neutral-600">Research a technical decision, compare AI answer engines, or collect evidence for a feature. Librarium keeps search results, grounded answers, and research reports distinct inside one shared format.</p>
        <div class="mt-12 grid grid-cols-1 gap-12 border-t border-neutral-950/15 pt-8 lg:grid-cols-3">
          <div>
            <h3 class="text-lg font-semibold text-neutral-950">Results, not just summaries</h3>
            <p class="mt-3 text-base/7 text-pretty text-neutral-600">Keep the content and citations from each successful provider.</p>
          </div>
          <div>
            <h3 class="text-lg font-semibold text-neutral-950">Provenance, not a confidence vote</h3>
            <p class="mt-3 text-base/7 text-pretty text-neutral-600">Record the source, variant, model, and retrieval service. Answers retrieved through the same service are not independent confirmation.</p>
          </div>
          <div>
            <h3 class="text-lg font-semibold text-neutral-950">Explicit execution policy</h3>
            <p class="mt-3 text-base/7 text-pretty text-neutral-600">The client supplies research and recovery. Your application owns tenant access, persistent keys for recovery, retention, and the UI.</p>
          </div>
        </div>
        <p class="mt-10 max-w-[72ch] text-base/7 text-pretty text-neutral-600" set:html={inline("For a concrete application-owned evidence model, read [Building answer visibility in Agentsy Report](/stories/agentsy-report). For your first executable workflow, follow [the multi-provider query guide](/guides/first-query).")} />
        <div class="mt-10 flex flex-wrap items-center gap-x-7 gap-y-4">
          <a href={ctaHref} class="inline-flex items-center gap-2 rounded bg-neutral-950 px-4 py-2.5 text-base font-medium text-white hover:bg-neutral-800 sm:text-sm">{ctaLabel} <Icon name="arrowRight" /></a>
          <a href="/cli" class="inline-flex items-center gap-2 py-2 text-base font-medium text-neutral-700 hover:text-neutral-950 sm:text-sm">Use the CLI instead</a>
          <CopyPageButton href={markdownHref} />
        </div>
      </div>
    </section>
    <p id="copy-status" role="status" class="sr-only"></p>
  </main>
  <Footer />
</Base>
