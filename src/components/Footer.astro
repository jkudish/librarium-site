---
import LogoMark from "./LogoMark.astro";
const creditUtm = "?utm_source=librarium&utm_medium=referral&utm_campaign=site_footer_credit";
const groups = [
  { title: "Use Librarium", links: [
    { href: "/agents", label: "Agents & MCP" },
    { href: "/cli", label: "CLI" },
    { href: "/javascript", label: "JavaScript" },
    { href: "/laravel", label: "Laravel" },
  ] },
  { title: "Resources", links: [
    { href: "/docs", label: "JavaScript docs" },
    { href: "/docs/php", label: "Laravel docs" },
    { href: "/guides", label: "Guides" },
    { href: "/compare/direct-provider-apis", label: "Direct APIs comparison" },
  ] },
  { title: "Project", links: [
    { href: "https://github.com/jkudish/librarium", label: "GitHub" },
    { href: "https://www.npmjs.com/package/librarium", label: "npm" },
    { href: "https://github.com/jkudish/librarium/blob/main/CHANGELOG.md", label: "Changelog" },
    { href: "https://github.com/jkudish/librarium/blob/main/LICENSE", label: "MIT License" },
  ] },
  { title: "For agents", links: [
    { href: "/index.md", label: "Homepage Markdown" },
    { href: "/llms.txt", label: "llms.txt" },
  ] },
];
---

<footer class="border-t border-neutral-950/10 py-12">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 lg:grid-cols-[1fr_2fr] lg:gap-12 lg:px-8">
    <div>
      <a href="/" aria-label="Homepage" class="inline-flex items-center gap-x-2 text-neutral-950"><LogoMark id="logo-footer" class="size-7 shrink-0" /><span class="font-mono text-lg font-semibold text-neutral-950">librarium</span></a>
      <p class="mt-4 max-w-[32ch] text-base/7 text-neutral-600 sm:text-sm/6">Give your agent more than one source.</p>
    </div>
    <nav class="grid grid-cols-2 gap-x-6 gap-y-8 text-base font-normal sm:grid-cols-4 sm:text-sm" aria-label="Footer navigation">
      {groups.map((group) => (
        <div>
          <h2 class="font-medium text-neutral-950">{group.title}</h2>
          <ul class="mt-3 space-y-1">
            {group.links.map((link) => (
              <li><a href={link.href} class="inline-block py-1.5 text-neutral-600 hover:text-neutral-950 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-amber-700">{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
  </div>
  <div class="mx-auto mt-10 max-w-6xl px-6 lg:px-8">
    <p class="border-t border-neutral-950/10 pt-6 text-base/7 text-neutral-500 sm:text-sm/6">Brought to you by <a href={`https://agentsy.build/${creditUtm}`} class="inline-flex items-baseline gap-x-1.5 font-medium text-neutral-700 hover:text-neutral-950"><svg data-brand="agentsy" class="size-[1.05em] shrink-0 self-center" viewBox="0 0 302 302" fill="currentColor" aria-hidden="true"><path d="M150.635 0C110.393 0 72.5823 15.6764 44.1167 44.1167C15.6764 72.557 0 110.393 0 150.635C0 190.877 15.6764 228.688 44.1167 257.153C72.557 285.594 110.393 301.27 150.635 301.27C190.877 301.27 228.688 285.594 257.153 257.153C285.594 228.713 301.27 190.877 301.27 150.635C301.27 110.393 285.594 72.5823 257.153 44.1167C228.688 15.6764 190.852 0 150.635 0ZM19.8044 194.549C15.1192 180.569 12.6627 165.779 12.6627 150.635C12.6627 113.787 27.0221 79.1416 53.0818 53.0818C79.1416 27.0221 113.787 12.6627 150.635 12.6627C165.805 12.6627 180.595 15.1445 194.574 19.8044C187.078 19.7537 179.278 20.3869 171.25 21.8051C137.238 27.8325 102.998 46.6492 74.8363 74.811C46.6745 102.973 27.8578 137.213 21.8304 171.224C20.4122 179.253 19.7791 187.053 19.8297 194.549H19.8044ZM34.2651 173.428C39.8367 141.948 57.4125 110.089 83.7761 83.7508C110.114 57.4125 141.974 39.8367 173.453 34.2651C180.418 33.0242 187.154 32.4164 193.612 32.4164C213.239 32.4164 230.41 38.0386 243.503 48.8272L167.679 124.651C160.917 131.413 149.445 128.855 146.203 119.865L126.601 65.8711L114.698 70.1764L135.262 126.854C138.352 135.338 132.046 144.304 123.03 144.304H72.7849V156.966H120.878C126.221 156.966 128.906 163.424 125.132 167.223L48.8525 243.503C34.4931 226.079 29.3014 201.488 34.2651 173.453V173.428ZM288.607 150.635C288.607 187.483 274.248 222.128 248.188 248.188C222.128 274.248 187.483 288.607 150.635 288.607C135.288 288.607 120.321 286.075 106.214 281.288C106.696 281.288 107.202 281.314 107.683 281.314C146.33 281.314 190.674 262.218 226.459 226.434C262.699 190.193 281.795 145.165 281.288 106.164C286.075 120.295 288.607 135.262 288.607 150.635ZM217.494 217.494C165.881 269.081 95.9323 283.846 57.767 252.417L133.566 176.619C140.328 169.857 151.8 172.415 155.042 181.405L174.01 233.677L185.913 229.371L165.982 174.415C162.892 165.931 169.198 156.966 178.214 156.966H228.46V144.304H180.367C175.023 144.304 172.339 137.846 176.112 134.047L252.392 57.767C283.821 95.9323 269.081 165.881 217.468 217.494H217.494Z"/></svg>Agentsy</a> and <a href={`https://jkudish.com/${creditUtm}`} class="font-medium text-neutral-700 hover:text-neutral-950">Joey Kudish</a>.</p>
  </div>
</footer>
