---
interface Props {
  id: string;
  version: "v1" | "v2";
  v1Href: string;
  v2Href: string;
}

const { id, version, v1Href, v2Href } = Astro.props;
---

<div>
  <label for={id} class="mb-1.5 block font-mono text-xs font-medium tracking-wide text-neutral-500 uppercase">
    Docs version
  </label>
  <div class="relative">
    <select
      id={id}
      data-docs-version-picker
      class="w-full appearance-none rounded-lg bg-white py-2 pr-9 pl-3 text-sm font-medium text-neutral-950 ring-1 ring-neutral-950/15 hover:ring-neutral-950/25 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600"
    >
      <option value={v2Href} selected={version === "v2"}>v2</option>
      <option value={v1Href} selected={version === "v1"}>v1 legacy</option>
    </select>
    <svg viewBox="0 0 16 16" class="pointer-events-none absolute top-1/2 right-3 size-4 -translate-y-1/2 fill-none stroke-neutral-600 stroke-[1.5]" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="m4 6 4 4 4-4" />
    </svg>
  </div>
  <noscript>
    <a href={version === "v2" ? v1Href : v2Href} class="mt-2 inline-block text-sm font-medium text-amber-700 underline underline-offset-2">
      {version === "v2" ? "Open v1 legacy docs" : "Open v2 docs"}
    </a>
  </noscript>
</div>

<script>
  document.querySelectorAll<HTMLSelectElement>("[data-docs-version-picker]").forEach((picker) => {
    if (picker.dataset.bound === "true") return;
    picker.dataset.bound = "true";
    picker.addEventListener("change", () => {
      window.location.assign(picker.value);
    });
  });
</script>
