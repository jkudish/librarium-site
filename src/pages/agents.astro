---
// Dedicated product page for /agents. src/content/pages/agents.md stays the
// source of truth for the agent-readable twin at /agents.md (served by
// [...page].md.ts and bundled into the llms files); every fact rendered here
// mirrors that file, and scripts/verify-content.mjs checks this page's HTML
// for each host registration, docs link, and tool contract.
import { getEntry } from "astro:content";
import { Code } from "astro:components";
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import CopyPageButton from "../components/CopyPageButton.astro";
import ResearchSteps from "../components/ResearchSteps.astro";
import { agentSetupPromptFor } from "../data/setup-prompt";

const entry = await getEntry("pages", "agents");
if (!entry) throw new Error("src/content/pages/agents.md is missing");
const { title, description } = entry.data;
const ctaHref = entry.data.ctaHref ?? "/docs/using-with-agents";
const ctaLabel = entry.data.ctaLabel ?? "Read the agent docs";
const markdownHref = "/agents.md";

/** Static, trusted copy only: escape, then render `code` and [links](href). */
const inline = (text: string) =>
  text
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/`([^`]+)`/g, '<code class="rounded-sm bg-neutral-950/4 px-0.5 py-px font-mono text-[0.875em] text-neutral-950">$1</code>')
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" class="font-medium text-amber-700 underline decoration-amber-700/30 underline-offset-[3px] hover:text-amber-600">$1</a>');

type Lang = "bash" | "toml" | "json" | "yaml";
interface Host {
  id: string;
  name: string;
  logo?: string;
  docs: { label: string; href: string }[];
  intro: string;
  blocks: { label: string; lang: Lang; code: string }[];
  note?: string;
}

// Registration strings are copied verbatim from agents.md. Keep them in sync.
const hosts: Host[] = [
  {
    id: "amp", name: "Amp", logo: "/agents/amp.svg",
    docs: [{ label: "MCP docs", href: "https://ampcode.com/docs/customize/mcp" }],
    intro: "Register user-wide from your terminal.",
    blocks: [
      { label: "Terminal (user-wide)", lang: "bash", code: "amp mcp add librarium -- librarium mcp" },
    ],
  },
  {
    id: "claude-code",
    name: "Claude Code",
    logo: "/providers/claude.svg",
    docs: [{ label: "MCP docs", href: "https://code.claude.com/docs/en/mcp" }],
    intro: "Register user-wide from your terminal.",
    blocks: [{ label: "Terminal", lang: "bash", code: "claude mcp add --scope user librarium -- librarium mcp" }],
  },
  {
    id: "claude-desktop", name: "Claude Desktop", logo: "/providers/claude.svg",
    docs: [{ label: "local server docs", href: "https://modelcontextprotocol.io/docs/develop/connect-local-servers" }],
    intro: "Open Settings, then Developer, then Edit Config; merge this entry and restart Claude Desktop.",
    blocks: [{ label: "claude_desktop_config.json", lang: "json", code: '{\n  "mcpServers": {\n    "librarium": {\n      "command": "librarium",\n      "args": ["mcp"]\n    }\n  }\n}' }],
  },
  {
    id: "codex",
    name: "Codex",
    logo: "/agents/codex.svg",
    docs: [{ label: "MCP docs", href: "https://learn.chatgpt.com/codex/extend/mcp" }],
    intro: "Merge into `~/.codex/config.toml` for user-wide setup.",
    blocks: [{ label: "config.toml", lang: "toml", code: '[mcp_servers.librarium]\ncommand = "librarium"\nargs = ["mcp"]' }],
  },
  {
    id: "command-code", name: "Command Code", logo: "/agents/command-code.svg",
    docs: [{ label: "MCP docs", href: "https://commandcode.ai/docs/mcp" }],
    intro: "Register user-wide from your terminal.",
    blocks: [{ label: "Terminal", lang: "bash", code: "cmd mcp add --scope user librarium -- librarium mcp" }],
  },
  {
    id: "cursor",
    name: "Cursor",
    logo: "/agents/cursor.svg",
    docs: [{ label: "MCP docs", href: "https://cursor.com/docs/mcp" }],
    intro: "Merge into `~/.cursor/mcp.json` for user-wide setup.",
    blocks: [{ label: "mcp.json", lang: "json", code: '{\n  "mcpServers": {\n    "librarium": {\n      "type": "stdio",\n      "command": "librarium",\n      "args": ["mcp"]\n    }\n  }\n}' }],
  },
  {
    id: "devin", name: "Devin", logo: "/agents/devin.svg",
    docs: [{ label: "MCP docs", href: "https://docs.devin.ai/cli/extensibility/mcp/configuration" }],
    intro: "For Devin for Terminal, register user-wide from your terminal.",
    blocks: [{ label: "Terminal", lang: "bash", code: "devin mcp add --scope user librarium -- librarium mcp" }],
  },
  {
    id: "gemini-cli", name: "Gemini CLI", logo: "/providers/gemini.svg",
    docs: [{ label: "MCP docs", href: "https://geminicli.com/docs/tools/mcp-server/" }],
    intro: "Register user-wide from your terminal.",
    blocks: [{ label: "Terminal", lang: "bash", code: "gemini mcp add --scope user librarium librarium mcp" }],
  },
  {
    id: "grok-build", name: "Grok Build", logo: "/agents/grok.png",
    docs: [{ label: "MCP docs", href: "https://docs.x.ai/build/features/mcp-servers" }],
    intro: "Register user-wide from your terminal.",
    blocks: [{ label: "Terminal", lang: "bash", code: "grok mcp add librarium -- librarium mcp" }],
  },
  {
    id: "hermes", name: "Hermes Agent", logo: "/agents/hermes.png",
    docs: [{ label: "MCP docs", href: "https://hermes-agent.nousresearch.com/docs/user-guide/features/mcp" }],
    intro: "Merge into `~/.hermes/config.yaml` for user-wide.",
    blocks: [{ label: "~/.hermes/config.yaml", lang: "yaml", code: 'mcp_servers:\n  librarium:\n    command: "librarium"\n    args: ["mcp"]' }],
  },
  {
    id: "muse", name: "Muse", logo: "/agents/muse.svg",
    docs: [{ label: "official page", href: "https://muse.ai/" }],
    intro: "Muse doesn't document a manual MCP config; let Muse follow [install.md](/install.md).",
    blocks: [],
  },
  {
    id: "openclaw", name: "OpenClaw", logo: "/agents/openclaw.svg",
    docs: [{ label: "MCP registry docs", href: "https://docs.openclaw.ai/cli/mcp/registry" }],
    intro: "Register in OpenClaw's user configuration.",
    blocks: [{ label: "Terminal", lang: "bash", code: "openclaw mcp add librarium --command librarium --arg mcp" }],
    note: "Ask before stopping a running Gateway; CLI changes require it stopped, or use the Control UI.",
  },
  {
    id: "opencode",
    name: "OpenCode",
    logo: "/agents/opencode.svg",
    docs: [
      { label: "v2 MCP docs", href: "https://opencode.ai/v2/docs/mcp-servers/" },
    ],
    intro: "With OpenCode v2, register user-wide from your terminal.",
    blocks: [
      { label: "Terminal (v2)", lang: "bash", code: "opencode mcp add librarium --global -- librarium mcp" },
    ],
  },
  {
    id: "pi", name: "Pi", logo: "/agents/pi.svg",
    docs: [{ label: "MCP docs", href: "https://pi.dev/docs/latest/mcp" }],
    intro: "Register user-wide with Pi's native MCP support.",
    blocks: [{ label: "Terminal", lang: "bash", code: "pi mcp add librarium -- librarium mcp" }],
    note: "An extension providing `/mcp` overrides native support; resolve that conflict first.",
  },
  {
    id: "vscode", name: "VS Code (GitHub Copilot)", logo: "/agents/vscode.png",
    docs: [{ label: "MCP docs", href: "https://code.visualstudio.com/docs/copilot/customization/mcp-servers" }],
    intro: "Run MCP: Open User Configuration and merge this entry.",
    blocks: [{ label: "mcp.json (VS Code format)", lang: "json", code: '{\n  "servers": {\n    "librarium": {\n      "type": "stdio",\n      "command": "librarium",\n      "args": ["mcp"]\n    }\n  }\n}' }],
  },
  {
    id: "zed", name: "Zed", logo: "/agents/zed.png",
    docs: [{ label: "MCP docs", href: "https://zed.dev/docs/ai/mcp" }],
    intro: "Open zed: open settings file and merge this user-wide entry into settings.",
    blocks: [{ label: "Zed settings", lang: "json", code: '{\n  "context_servers": {\n    "librarium": {\n      "command": "librarium",\n      "args": ["mcp"]\n    }\n  }\n}' }],
  },
  {
    id: "other",
    name: "Other",
    docs: [],
    intro: "Register a stdio server named `librarium` with command `librarium` and args `[\"mcp\"]`, following your host's own config format.",
    blocks: [],
  },
];

// Detailed contracts live in /docs/using-with-agents.
const tools = [
  { name: "research", description: "Preview or start research across your chosen sources." },
  { name: "get_run", description: "Read saved answers and citations, or resume pending research." },
  { name: "list_sources", description: "Discover configured sources and price hints without making provider calls." },
];

const examplePrompt = "Use Librarium to compare SQLite and Postgres for our team app, with sources.";
const exampleOutcome = "A recommendation grounded in deployment and concurrency evidence, with links to the sources.";

const sectionHeading = "max-w-[22ch] text-3xl font-medium tracking-tight text-balance text-neutral-950 sm:text-5xl";
const codeLink = "font-medium text-amber-700 underline decoration-amber-700/30 underline-offset-[3px] hover:text-amber-600";
---

<Base title={`${title} | Librarium`} description={description} includeSoftwareMetadata={false}>
  <Header />
  <main>
    <!-- Hero: same pieces and classes ArticleLayout uses for kind: product. -->
    <div class="border-b border-neutral-200 bg-[#faf9f6]">
      <div class="mx-auto grid max-w-6xl gap-12 px-6 pt-10 pb-12 sm:pt-14 sm:pb-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,22rem)] lg:items-end lg:px-8">
        <div>
          <p class="mb-4 font-mono text-xs tracking-wide text-amber-700 uppercase">A meta harness for research queries</p>
          <h1 class="max-w-[21ch] text-4xl/[1.08] font-medium tracking-[-0.045em] text-pretty text-neutral-950 sm:text-6xl/[1.06]">{title}</h1>
          <p class="mt-6 max-w-[58ch] text-lg/8 text-pretty text-neutral-600">Query search, AI answers, and deep research with citations.</p>
          <p class="mt-6 max-w-[58ch] text-lg/8 text-pretty text-neutral-600">{description}</p>
          <div class="mt-8 flex flex-wrap items-center gap-x-7 gap-y-4">
            <a href={ctaHref} class="inline-flex items-center gap-2 rounded bg-neutral-950 px-4 py-2.5 text-base font-medium text-white hover:bg-neutral-800 sm:text-sm">{ctaLabel} <Icon name="arrowRight" /></a>
            <a href="#setup" class="inline-flex items-center gap-2 py-2 text-base font-medium text-neutral-700 hover:text-neutral-950 sm:text-sm">Set it up</a>
            <CopyPageButton href={markdownHref} />
          </div>
        </div>
        <div class="lg:pb-2">
          <p class="text-sm text-neutral-500">Works with the agent you already use</p>
          <ul class="mt-4 grid grid-cols-3 gap-2 sm:grid-cols-6 lg:grid-cols-3" aria-label="Supported coding agents">
            {hosts.filter((host) => host.logo).map((host) => (
              <li>
                <a href={`#host-tab-${host.id}`} data-host-link={host.id} class="flex h-full flex-col items-center gap-2 rounded-md border border-neutral-200 bg-white px-2 py-3 text-center text-xs text-neutral-700 hover:border-neutral-300 hover:text-neutral-950">
                  <span class="logo-tile flex size-8 items-center justify-center rounded-md"><img src={host.logo} alt="" width="20" height="20" class="logo-mono size-5 object-contain grayscale" /></span>
                  {host.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <!-- One illustrative prompt and outcome, not a captured research result. -->
    <section class="py-16 sm:py-24" aria-labelledby="usage-heading">
      <div class="mx-auto max-w-6xl px-6 lg:px-8">
        <h2 id="usage-heading" class={sectionHeading}>Ask a question. Your agent does the reading.</h2>
        <p class="mt-5 max-w-[62ch] text-lg/8 text-pretty text-neutral-600">Ask in plain language and get a source-backed recommendation.</p>
        <figure class="mt-8 max-w-3xl rounded-lg border border-neutral-200 bg-white p-6" aria-label="Example prompt and outcome">
          <div class="flex items-center justify-between gap-3">
            <p class="font-mono text-xs text-neutral-500 uppercase">Prompt</p>
            <button type="button" class="copy-btn group" data-copy={examplePrompt} data-copy-state="idle" aria-label="Copy example prompt"><Icon name="copy" class="size-4 group-data-[copy-state=success]:hidden" /><Icon name="check" class="hidden size-4 text-amber-700 group-data-[copy-state=success]:block" /></button>
          </div>
          <blockquote class="mt-2 text-base/7 text-neutral-950">{examplePrompt}</blockquote>
          <p class="mt-5 font-mono text-xs text-neutral-500 uppercase">Illustrative outcome</p>
          <p class="mt-2 text-base/7 text-neutral-600">{exampleOutcome}</p>
        </figure>
      </div>
    </section>

    <!-- Setup: install, setup prompt, and per-host registration tabs. -->
    <section id="setup" class="scroll-mt-6 border-t border-neutral-200 bg-[#faf9f6] py-16 sm:py-24" aria-labelledby="setup-heading">
      <div class="mx-auto max-w-6xl px-6 lg:px-8">
        <h2 id="setup-heading" class={sectionHeading}>Set it up once.</h2>
        <div class="mt-10 grid grid-cols-1 items-start gap-10 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-12">
          <div class="min-w-0">
            <p class="font-mono text-xs tracking-wide text-neutral-500 uppercase">One install, two ways to work</p>
            <h3 class="mt-3 text-xl font-medium tracking-tight text-neutral-950">Install the CLI</h3>
            <p class="mt-2 text-base/7 text-pretty text-neutral-600 sm:text-sm/6">The CLI includes the MCP server.</p>
            <div class="mt-4"><ResearchSteps /></div>
          </div>
          <div class="min-w-0" data-agent-setup>
            <p class="font-mono text-xs tracking-wide text-neutral-500 uppercase">Or let your agent do it</p>
            <h3 class="mt-3 text-xl font-medium tracking-tight text-neutral-950">Choose your agent below</h3>
            <p class="mt-2 text-base/7 text-pretty text-neutral-600 sm:text-sm/6" set:html={inline("Copy its prompt to install and verify Librarium; [install.md](/install.md) has the full instructions.")} />
          <noscript><style is:inline>[data-host-panel][hidden]{display:block !important}#host-tabs{display:none !important}</style></noscript>
          <div id="host-tabs" role="tablist" aria-label="Coding agent" class="host-tabs mt-5 grid grid-cols-2 gap-2 sm:grid-cols-3">
            {hosts.map((host, index) => (
              <button type="button" role="tab" id={`host-tab-${host.id}`} aria-selected={index === 0 ? "true" : "false"} aria-controls={`host-panel-${host.id}`} tabindex={index === 0 ? 0 : -1} class="flex min-h-12 min-w-0 cursor-pointer items-center gap-2 rounded-md border border-neutral-200 px-3 py-2 text-left text-sm text-neutral-500 hover:text-neutral-950 aria-selected:border-amber-700 aria-selected:font-medium aria-selected:text-neutral-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700">
                {host.logo
                  ? <span class="logo-tile flex size-6 shrink-0 items-center justify-center rounded"><img src={host.logo} alt="" width="16" height="16" class="logo-mono size-4 object-contain grayscale" /></span>
                  : <span class="flex size-6 items-center justify-center rounded border border-neutral-200 text-neutral-600"><Icon name="plus" class="size-3.5" /></span>}
                <span>{host.name}</span>
              </button>
            ))}
          </div>
          {hosts.map((host, index) => (
            <div id={`host-panel-${host.id}`} role="tabpanel" aria-labelledby={`host-tab-${host.id}`} tabindex="0" data-host-panel hidden={index !== 0} class="mt-6 min-w-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700">
              <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
                <div class="flex items-center gap-3">
                  {host.logo
                    ? <span class="logo-tile flex size-10 items-center justify-center rounded-md border border-neutral-200"><img src={host.logo} alt="" width="24" height="24" class="logo-mono size-6 object-contain grayscale" /></span>
                    : <span class="flex size-10 items-center justify-center rounded-md border border-neutral-200 text-neutral-600"><Icon name="terminal" class="size-5" /></span>}
                  <p class="text-lg font-medium text-neutral-950">{host.id === "other" ? "Any other MCP host" : host.name}</p>
                </div>
                {host.docs.length > 0 && (
                  <p class="flex flex-wrap gap-x-5 gap-y-1 text-sm">
                    {host.docs.map((doc) => (
                      <a href={doc.href} class={codeLink}>{host.name} {doc.label} <Icon name="arrowUpRight" class="inline-block" /></a>
                    ))}
                  </p>
                )}
              </div>
              <div class="code-panel mt-4 min-w-0">
                <div class="code-toolbar"><span>Paste into {host.id === "other" ? "your agent" : host.name}</span><button type="button" class="copy-btn group" data-copy={agentSetupPromptFor(host.id === "other" ? "my coding agent" : host.name)} data-copy-state="idle" aria-label={`Copy setup prompt for ${host.name}`}><Icon name="copy" class="size-4 group-data-[copy-state=success]:hidden" /><Icon name="check" class="hidden size-4 text-amber-300 group-data-[copy-state=success]:block" /><span class="copy-label">Copy prompt</span></button></div>
                <p class="px-5 py-4 font-mono text-xs/6 break-words whitespace-pre-wrap text-amber-100">{agentSetupPromptFor(host.id === "other" ? "my coding agent" : host.name).replace(/\/install\.md$/, "")}<wbr />/install.md</p>
              </div>
              {(host.blocks.length > 0 || host.id === "other") && <p class="mt-6 text-sm font-medium text-neutral-950">Or register it yourself</p>}
              <p class="mt-1 max-w-[75ch] text-base/7 text-pretty text-neutral-600 sm:text-sm/6" set:html={inline(host.intro)} />
              {host.blocks.length > 0 && (
                <div class:list={["mt-4 grid gap-4", host.blocks.length > 1 && "lg:grid-cols-2"]}>
                  {host.blocks.map((block) => (
                    <div class:list={["code-panel min-w-0", block.lang === "bash" && "code-panel-wrap"]}>
                      <div class="code-toolbar"><span>{block.label}</span><button type="button" class="copy-btn group" data-copy={block.code} data-copy-state="idle" aria-label={`Copy ${host.name} ${block.label === "Terminal" ? "command" : block.label}`}><Icon name="copy" class="size-4 group-data-[copy-state=success]:hidden" /><Icon name="check" class="hidden size-4 text-amber-300 group-data-[copy-state=success]:block" /><span class="copy-label">Copy</span></button></div>
                      <Code code={block.code} lang={block.lang} theme="github-dark-default" />
                    </div>
                  ))}
                </div>
              )}
              {host.id === "other" && (
                <dl class="mt-4 grid max-w-md grid-cols-[auto_1fr] gap-x-6 gap-y-2 rounded-md border border-neutral-200 bg-neutral-50 p-4 font-mono text-sm">
                  <dt class="text-neutral-500">name</dt><dd class="text-neutral-950">librarium</dd>
                  <dt class="text-neutral-500">transport</dt><dd class="text-neutral-950">stdio</dd>
                  <dt class="text-neutral-500">command</dt><dd class="text-neutral-950">librarium</dd>
                  <dt class="text-neutral-500">args</dt><dd class="text-neutral-950">["mcp"]</dd>
                </dl>
              )}
              {host.note && <p class="mt-4 max-w-[75ch] text-base/7 text-pretty text-neutral-600 sm:text-sm/6" set:html={inline(host.note)} />}
            </div>
          ))}
          </div>
        </div>
        <p id="copy-status" role="status" class="sr-only"></p>
      </div>
    </section>

    <!-- Tool reference. -->
    <section class="py-16 sm:py-24" aria-labelledby="tools-heading">
      <div class="mx-auto max-w-6xl px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.6fr)] lg:gap-12">
          <div class="lg:sticky lg:top-8 lg:self-start">
            <h2 id="tools-heading" class={sectionHeading}>What your agent can call</h2>
            <p class="mt-5 text-base/7 text-pretty text-neutral-600" set:html={inline("Three tools, with [inputs and limits](/docs/using-with-agents#mcp-server) in the agent docs.")} />
          </div>
          <div class="min-w-0 rounded-lg border border-neutral-200 bg-white">
            <table class="w-full text-left text-sm/6">
              <caption class="sr-only">What your agent can call</caption>
              <thead class="bg-neutral-50 text-neutral-950"><tr>{["Tool", "What it does"].map((label) => <th scope="col" class="p-4">{label}</th>)}</tr></thead>
              <tbody>{tools.map((tool) => <tr class="border-t border-neutral-200 align-top">
                <th scope="row" class="p-4 font-mono text-neutral-950">{tool.name}</th>
                <td class="p-4 text-neutral-600">{tool.description}</td>
              </tr>)}</tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- Reading guidance. -->
    <section class="border-y border-neutral-300 bg-[#eeeae0] py-16 sm:py-24" aria-labelledby="evidence-heading">
      <div class="mx-auto max-w-6xl px-6 lg:px-8">
        <h2 id="evidence-heading" class={sectionHeading}>Read everything. Then check it.</h2>
        <div class="mt-12 grid grid-cols-1 gap-12 border-t border-neutral-950/15 pt-8 lg:grid-cols-2">
          <div>
            <h3 class="text-lg font-semibold text-neutral-950">Ask for the whole answer</h3>
            <p class="mt-3 text-base/7 text-pretty text-neutral-600" set:html={inline("Ask your agent to [read every saved answer](/docs/using-with-agents#read-evidence-not-just-the-index) before summarizing.")} />
          </div>
          <div>
            <h3 class="text-lg font-semibold text-neutral-950">Check the sources, not just the summary</h3>
            <p class="mt-3 text-base/7 text-pretty text-neutral-600" set:html={inline("[Open the cited sources](/docs/using-with-agents#read-evidence-not-just-the-index) before relying on a recommendation.")} />
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  /* Monochrome marks stay legible on light tiles in both themes. */
  .logo-tile { background: #fbfaf7; color-scheme: light; }
  /* Keep the selected host visible above the global dark neutral borders. */
  #host-tabs [aria-selected="true"] { border-color: var(--color-amber-700); }
  .code-panel {
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--color-neutral-950);
  }
  .code-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
    padding: 0.5rem 0.75rem 0.5rem 1.25rem;
    color: var(--color-neutral-400);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .code-toolbar > span { min-width: 0; }
  .code-toolbar .copy-btn { flex-shrink: 0; white-space: nowrap; color: var(--color-neutral-300); padding: 0.375rem 0.5rem; }
  .code-toolbar .copy-btn:hover { color: var(--color-amber-300); background: rgb(255 255 255 / 0.06); }
  /* Shell commands wrap at spaces, never inside a token; config files keep their shape. */
  .code-panel-wrap :global(pre) { white-space: pre-wrap; overflow-wrap: normal; word-break: normal; }
  .code-panel :global(pre) {
    margin: 0;
    padding: 1rem 1.25rem;
    background: transparent !important;
    overflow-x: auto;
    font-size: var(--text-sm);
    line-height: 1.5rem;
  }
  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    border-radius: var(--radius-sm);
    padding: 0.375rem;
    cursor: pointer;
    color: var(--color-neutral-500);
  }
  .copy-btn:hover { color: var(--color-neutral-950); background: rgb(10 10 10 / 0.04); }
  .copy-btn:focus-visible { outline: 2px solid var(--color-amber-600); outline-offset: 2px; }
  :global(:root[data-theme="dark"]) .copy-btn:not(.code-toolbar .copy-btn):hover { color: #fff; background: #33352f; }
</style>

<script>
  const status = document.getElementById("copy-status");
  for (const button of document.querySelectorAll<HTMLButtonElement>(".copy-btn[data-copy]")) {
    let reset: ReturnType<typeof setTimeout>;
    button.addEventListener("click", async () => {
      clearTimeout(reset);
      const label = button.querySelector<HTMLElement>(".copy-label");
      const original = label?.dataset.original ?? label?.textContent ?? "";
      if (label) label.dataset.original = original;
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
        button.dataset.copyState = "success";
        if (label) label.textContent = "Copied";
        if (status) status.textContent = "Copied to clipboard.";
      } catch {
        button.dataset.copyState = "error";
        if (label) label.textContent = "Select to copy";
        if (status) status.textContent = "Copy unavailable. Select the text and copy it manually.";
      }
      reset = setTimeout(() => {
        button.dataset.copyState = "idle";
        if (label) label.textContent = original;
        if (status) status.textContent = "";
      }, 2000);
    });
  }

  // Host tabs: every panel is server-rendered; script only toggles them.
  const tabs = [...document.querySelectorAll<HTMLButtonElement>("#host-tabs [role=tab]")];
  function selectHost(selected: HTMLButtonElement, focus = false) {
    for (const tab of tabs) {
      const active = tab === selected;
      tab.setAttribute("aria-selected", String(active));
      tab.tabIndex = active ? 0 : -1;
      const panel = document.getElementById(tab.getAttribute("aria-controls")!);
      if (panel) panel.hidden = !active;
    }
    if (focus) selected.focus();
    selected.scrollIntoView({ block: "nearest", inline: "nearest" });
  }
  for (const [index, tab] of tabs.entries()) {
    tab.addEventListener("click", () => selectHost(tab));
    tab.addEventListener("keydown", (event) => {
      let next: number;
      switch (event.key) {
        case "ArrowRight": next = (index + 1) % tabs.length; break;
        case "ArrowLeft": next = (index + tabs.length - 1) % tabs.length; break;
        case "ArrowDown": next = (index + 1) % tabs.length; break;
        case "ArrowUp": next = (index + tabs.length - 1) % tabs.length; break;
        case "Home": next = 0; break;
        case "End": next = tabs.length - 1; break;
        default: return;
      }
      event.preventDefault();
      selectHost(tabs[next], true);
    });
  }
  // Hero logo shortcuts open the matching tab.
  for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-host-link]")) {
    link.addEventListener("click", (event) => {
      const tab = document.getElementById(`host-tab-${link.dataset.hostLink}`) as HTMLButtonElement | null;
      if (!tab) return;
      event.preventDefault();
      selectHost(tab);
      document.getElementById("setup")?.scrollIntoView({ behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
      tab.focus({ preventScroll: true });
    });
  }
</script>
