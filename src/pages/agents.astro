---
// Dedicated product page for /agents. src/content/pages/agents.md stays the
// source of truth for the agent-readable twin at /agents.md (served by
// [...page].md.ts and bundled into the llms files); every fact rendered here
// mirrors that file, and scripts/verify-content.mjs checks this page's HTML
// for each host registration, docs link, and tool contract.
import { getEntry } from "astro:content";
import { Code } from "astro:components";
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import CopyPageButton from "../components/CopyPageButton.astro";
import ResearchSteps from "../components/ResearchSteps.astro";
import { agentSetupPromptFor } from "../data/setup-prompt";

const entry = await getEntry("pages", "agents");
if (!entry) throw new Error("src/content/pages/agents.md is missing");
const { title, description } = entry.data;
const ctaHref = entry.data.ctaHref ?? "/docs/using-with-agents";
const ctaLabel = entry.data.ctaLabel ?? "Read the agent docs";
const markdownHref = "/agents.md";

/** Static, trusted copy only: escape, then render `code` and [links](href). */
const inline = (text: string) =>
  text
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/`([^`]+)`/g, '<code class="rounded-sm bg-neutral-950/4 px-0.5 py-px font-mono text-[0.875em] text-neutral-950">$1</code>')
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" class="font-medium text-amber-700 underline decoration-amber-700/30 underline-offset-[3px] hover:text-amber-600">$1</a>');

type Lang = "bash" | "toml" | "json" | "yaml";
interface Host {
  id: string;
  name: string;
  logo?: string;
  docs: { label: string; href: string }[];
  intro: string;
  blocks: { label: string; lang: Lang; code: string }[];
  note?: string;
}

// Registration strings are copied verbatim from agents.md. Keep them in sync.
const hosts: Host[] = [
  {
    id: "amp", name: "Amp", logo: "/agents/amp.svg",
    docs: [{ label: "MCP docs", href: "https://ampcode.com/docs/customize/mcp" }],
    intro: "User-wide: add it by command, or merge into `~/.config/amp/settings.json`. For this project, merge into `.amp/settings.json` instead, then approve with `amp mcp approve librarium`.",
    blocks: [
      { label: "Terminal (user-wide)", lang: "bash", code: "amp mcp add librarium -- librarium mcp" },
      { label: "Amp settings", lang: "json", code: '{\n  "amp.mcpServers": {\n    "librarium": {\n      "command": "librarium",\n      "args": ["mcp"]\n    }\n  }\n}' },
    ],
    note: "User settings do not require workspace-server approval. Preserve every other server when merging configuration.",
  },
  {
    id: "claude-code",
    name: "Claude Code",
    logo: "/providers/claude.svg",
    docs: [{ label: "MCP docs", href: "https://code.claude.com/docs/en/mcp" }],
    intro: "Use `--scope user` for user-wide; use `--scope local` for this project privately, or `--scope project` for a shared `.mcp.json`.",
    blocks: [{ label: "Terminal", lang: "bash", code: "claude mcp add --scope user librarium -- librarium mcp" }],
  },
  {
    id: "claude-desktop", name: "Claude Desktop", logo: "/providers/claude.svg",
    docs: [{ label: "local server docs", href: "https://modelcontextprotocol.io/docs/develop/connect-local-servers" }],
    intro: "Open Settings → Developer → Edit Config. Merge this user-wide entry into `claude_desktop_config.json`: macOS `~/Library/Application Support/Claude/claude_desktop_config.json`; Windows `%APPDATA%\\Claude\\claude_desktop_config.json`.",
    blocks: [{ label: "claude_desktop_config.json", lang: "json", code: '{\n  "mcpServers": {\n    "librarium": {\n      "command": "librarium",\n      "args": ["mcp"]\n    }\n  }\n}' }],
    note: "Completely quit and restart Claude Desktop. The linked docs do not document a project-only scope; do not substitute a project file.",
  },
  {
    id: "codex",
    name: "Codex",
    logo: "/agents/codex.svg",
    docs: [{ label: "MCP docs", href: "https://learn.chatgpt.com/codex/extend/mcp" }],
    intro: "Merge into `~/.codex/config.toml` for user-wide, or `.codex/config.toml` for this project (trusted projects only).",
    blocks: [{ label: "config.toml", lang: "toml", code: '[mcp_servers.librarium]\ncommand = "librarium"\nargs = ["mcp"]' }],
  },
  {
    id: "command-code", name: "Command Code", logo: "/agents/command-code.svg",
    docs: [{ label: "MCP docs", href: "https://commandcode.ai/docs/mcp" }],
    intro: "Use `--scope user` for user-wide (`~/.commandcode/mcp.json`); use `--scope local` for this project privately, or `--scope project` for a shared `.mcp.json`. Flags go before the server name.",
    blocks: [{ label: "Terminal", lang: "bash", code: "cmd mcp add --scope user librarium -- librarium mcp" }],
  },
  {
    id: "cursor",
    name: "Cursor",
    logo: "/agents/cursor.svg",
    docs: [{ label: "MCP docs", href: "https://cursor.com/docs/mcp" }],
    intro: "Merge into `~/.cursor/mcp.json` for user-wide, or `.cursor/mcp.json` for this project.",
    blocks: [{ label: "mcp.json", lang: "json", code: '{\n  "mcpServers": {\n    "librarium": {\n      "type": "stdio",\n      "command": "librarium",\n      "args": ["mcp"]\n    }\n  }\n}' }],
  },
  {
    id: "gemini-cli", name: "Gemini CLI", logo: "/providers/gemini.svg",
    docs: [{ label: "MCP docs", href: "https://geminicli.com/docs/tools/mcp-server/" }],
    intro: "Use `--scope user` for user-wide (`~/.gemini/settings.json`), or `--scope project` for this project (`.gemini/settings.json`).",
    blocks: [{ label: "Terminal", lang: "bash", code: "gemini mcp add --scope user librarium librarium mcp" }],
  },
  {
    id: "hermes", name: "Hermes Agent", logo: "/agents/hermes.png",
    docs: [{ label: "MCP docs", href: "https://hermes-agent.nousresearch.com/docs/user-guide/features/mcp" }],
    intro: "Merge into `~/.hermes/config.yaml` for user-wide.",
    blocks: [{ label: "~/.hermes/config.yaml", lang: "yaml", code: 'mcp_servers:\n  librarium:\n    command: "librarium"\n    args: ["mcp"]' }],
    note: "The linked MCP docs do not document a project-only config file. If that scope is required, ask rather than inventing one.",
  },
  {
    id: "openclaw", name: "OpenClaw", logo: "/agents/openclaw.svg",
    docs: [{ label: "MCP registry docs", href: "https://docs.openclaw.ai/cli/mcp/registry" }],
    intro: "Save it in OpenClaw's user configuration. The local Gateway must be stopped before CLI mutations; ask before stopping a running Gateway, or use its Control UI.",
    blocks: [{ label: "Terminal", lang: "bash", code: "openclaw mcp add librarium --command librarium --arg mcp" }],
    note: "The linked registry docs do not document a project-only registration scope.",
  },
  {
    id: "opencode",
    name: "OpenCode",
    logo: "/agents/opencode.svg",
    docs: [
      { label: "v2 MCP docs", href: "https://opencode.ai/v2/docs/mcp-servers/" },
      { label: "config locations", href: "https://opencode.ai/v2/docs/config/" },
      { label: "v1 MCP docs", href: "https://opencode.ai/docs/mcp-servers/" },
    ],
    intro: "For v2, use `--global` for user-wide; omit it for this project. Or merge under `mcp.servers` in `~/.config/opencode/opencode.json` for user-wide, or `opencode.json` in this project.",
    blocks: [
      { label: "Terminal (v2)", lang: "bash", code: "opencode mcp add librarium --global -- librarium mcp" },
      { label: "opencode.json (v2)", lang: "json", code: '{\n  "mcp": {\n    "servers": {\n      "librarium": {\n        "type": "local",\n        "command": ["librarium", "mcp"]\n      }\n    }\n  }\n}' },
    ],
    note: "For OpenCode v1, put `librarium` directly under `mcp`, without the `servers` wrapper. Keep the same `type` and `command` fields; do not apply the v2 layout to v1.",
  },
  {
    id: "pi", name: "Pi", logo: "/agents/pi.svg",
    docs: [{ label: "MCP docs", href: "https://pi.dev/docs/latest/mcp" }],
    intro: "Current Pi has native MCP support. User-wide is the default (`~/.pi/agent/mcp.json`); add `--local` for this project (`.pi/mcp.json`, loaded after project trust).",
    blocks: [{ label: "Terminal", lang: "bash", code: "pi mcp add librarium -- librarium mcp" }],
    note: "An extension that registers `/mcp` replaces Pi's built-in MCP support. Resolve that conflict with the user first. Run `/reload` after changing configuration outside a session.",
  },
  {
    id: "vscode", name: "VS Code (GitHub Copilot)", logo: "/agents/vscode.png",
    docs: [{ label: "MCP docs", href: "https://code.visualstudio.com/docs/copilot/customization/mcp-servers" }],
    intro: "Run MCP: Open User Configuration for user-wide within the active VS Code profile; for this project, edit `.vscode/mcp.json`. Merge this VS Code-format entry.",
    blocks: [{ label: "mcp.json (VS Code format)", lang: "json", code: '{\n  "servers": {\n    "librarium": {\n      "type": "stdio",\n      "command": "librarium",\n      "args": ["mcp"]\n    }\n  }\n}' }],
    note: "For portable Copilot/Agent Host configuration, use `~/.copilot/mcp-config.json` user-wide or `.mcp.json` in this project, with `mcpServers` instead of `servers`.",
  },
  {
    id: "windsurf", name: "Windsurf", logo: "/agents/windsurf.svg",
    docs: [{ label: "Cascade MCP docs", href: "https://docs.windsurf.com/windsurf/cascade/mcp" }],
    intro: "These current docs apply to legacy Cascade, not the default Devin Local agent. Open Cascade's Actions → Open MCP config file and merge this user-wide entry. Current documented locations: macOS/Linux `~/.config/devin/mcp_config.json`; Windows `%APPDATA%\\devin\\mcp_config.json`.",
    blocks: [{ label: "mcp_config.json (Cascade)", lang: "json", code: '{\n  "mcpServers": {\n    "librarium": {\n      "command": "librarium",\n      "args": ["mcp"]\n    }\n  }\n}' }],
    note: "No project-only scope is documented here. Do not use these instructions for Devin Local.",
  },
  {
    id: "zed", name: "Zed", logo: "/agents/zed.png",
    docs: [{ label: "MCP docs", href: "https://zed.dev/docs/ai/mcp" }],
    intro: "Open zed: open settings file and merge this user-wide entry into settings.",
    blocks: [{ label: "Zed settings", lang: "json", code: '{\n  "context_servers": {\n    "librarium": {\n      "command": "librarium",\n      "args": ["mcp"]\n    }\n  }\n}' }],
    note: "The linked MCP docs do not document project-only server registration; do not assume project settings support it.",
  },
  {
    id: "other",
    name: "Other",
    docs: [],
    intro: "Register a stdio server named `librarium` with command `librarium` and args `[\"mcp\"]`, following your host's own config format.",
    blocks: [],
  },
];

// Tool contracts mirror "What your agent can call" in agents.md, which in
// turn mirrors src/mcp/run-server.ts in the librarium repository.
const tools = [
  {
    name: "research",
    input: "a required `question`, plus optional `depth` (`quick` or `deep`), `only`, `skip`, `max_cost`, `dry_run`, and `wait_seconds`.",
    output: "a bounded summary with id, source statuses, citation counts, costs, skips, and a next hint. It does not paste whole answers into chat.",
    use: "Use `dry_run: true` to preview offline. `max_cost` can lower but not raise the configured cap. Waiting defaults to 45 seconds, maximum 50.",
  },
  {
    name: "get_run",
    input: "the Run `id`, optionally `wait_seconds`, one `source`, and a `cursor`.",
    output: "a Run summary, or paged JSON text containing a source answer and citations.",
    use: "Follow `cursor` with unchanged id/source until null; concatenate pages before parsing. A changed answer invalidates an old cursor. Retrieves in-progress research without starting new research.",
  },
  {
    name: "list_sources",
    input: "none.",
    output: "research sources, AI answer engines chosen by name, saved groups, availability, and price hints.",
    use: "Offline discovery checks local configuration, not provider authentication. Save your own source lists as groups.",
  },
];

// Practical agent prompts for source selection and complete evidence reading.
const askPrompts = [
  {
    title: "Research a technical decision",
    prompt: "Use Librarium to compare SQLite and Postgres for a small team app. Start with quick research on deployment, concurrent writes, and operational overhead. Read the evidence and cite the sources behind your recommendation.",
  },
  {
    title: "Plan a provider matrix first",
    prompt: "Before implementing this integration, use the Librarium MCP tools to research the API’s authentication, rate limits, and retry guidance. Discover sources with list_sources, preview the selection with dry_run, and read the full results with get_run. Cite the relevant documentation.",
  },
  {
    title: "See how answer engines describe you",
    prompt: "Use Librarium to compare ChatGPT, Gemini, and Copilot answers about luxury villa rentals for a week on the Amalfi Coast. Which services appear, how are they described, and which sources get cited? Keep each engine’s findings separate.",
  },
];

// Illustrative summaries, not captured provider results.
const quickRun = "run_01JAB2C3D4E5F6G7H8J9K0M1N2";
const deepRun = "run_01JAB2C3D4E5F6G7H8J9K0M1N3";
type Turn =
  | { kind: "user"; text: string }
  | { kind: "agent"; text: string }
  | { kind: "tool"; name: string; input: string; output: string; note?: string };
const session: Turn[] = [
  { kind: "user", text: "Before I add retries to our webhook client, research current guidance on exponential backoff, jitter, and idempotency keys. Start with a quick pass, then go deeper if coverage is thin. Keep each source’s citations attached." },
  { kind: "agent", text: "First I’ll discover sources and preview the selection offline." },
  {
    kind: "tool",
    name: "list_sources",
    input: "{}",
    output: "sources: exa, gemini, openai, …; configured variants and price hints",
    note: "Local and free",
  },
  {
    kind: "tool",
    name: "research",
    input: 'question: "Retry backoff, jitter, and idempotency keys", only: ["exa", "gemini"], dry_run: true',
    output: 'status: "planned", selected sources and estimates, skipped sources',
    note: "Not stored; no provider calls",
  },
  {
    kind: "tool",
    name: "research",
    input: 'question: "Retry backoff, jitter, and idempotency keys", only: ["exa", "gemini"]',
    output: `id: "${quickRun}", status: "done", source statuses and citation counts`,
  },
  {
    kind: "tool",
    name: "get_run",
    input: `id: "${quickRun}", source: "exa"`,
    output: 'content: "JSON-text chunk with answer and citations", cursor: "…"',
    note: "Read each source until cursor is null",
  },
  { kind: "agent", text: "The quick answers support backoff with jitter but are thin on repeated idempotency keys. I’ll look for a deeper report on that part." },
  {
    kind: "tool",
    name: "research",
    input: 'question: "How should a server handle a repeated Idempotency-Key?", depth: "deep", only: ["openai"], wait_seconds: 0',
    output: `id: "${deepRun}", status: "running"`,
  },
  {
    kind: "tool",
    name: "get_run",
    input: `id: "${deepRun}", wait_seconds: 45`,
    output: 'status: "done", source statuses and citation counts',
    note: "Starts no new research",
  },
  {
    kind: "tool",
    name: "get_run",
    input: `id: "${deepRun}", source: "openai"`,
    output: 'content: "JSON text with answer and citations", cursor: null',
  },
];
const answer = [
  {
    claim: "Retry with capped exponential backoff and full jitter, not fixed intervals.",
    sources: [{ profile: "exa", source: "AWS Builders’ Library: Timeouts, retries, and backoff with jitter" }, { profile: "gemini", source: "Google Cloud: Retry strategy" }],
  },
  {
    claim: "Send an Idempotency-Key on every retried POST; the server returns the first response for a key it has already seen.",
    sources: [{ profile: "openai", source: "Stripe API reference: Idempotent requests" }, { profile: "openai", source: "IETF draft: The Idempotency-Key HTTP Header Field" }],
  },
  {
    claim: "Honor Retry-After on 429 and 503 before applying your own backoff.",
    sources: [{ profile: "gemini", source: "RFC 9110: HTTP Semantics" }],
  },
];

const sectionHeading = "max-w-[22ch] text-3xl font-medium tracking-tight text-balance text-neutral-950 sm:text-5xl";
const codeLink = "font-medium text-amber-700 underline decoration-amber-700/30 underline-offset-[3px] hover:text-amber-600";
---

<Base title={`${title} | Librarium`} description={description} includeSoftwareMetadata={false}>
  <Header />
  <main>
    <!-- Hero: same pieces and classes ArticleLayout uses for kind: product. -->
    <div class="border-b border-neutral-200 bg-[#faf9f6]">
      <div class="mx-auto grid max-w-6xl gap-12 px-6 pt-10 pb-12 sm:pt-14 sm:pb-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,22rem)] lg:items-end lg:px-8">
        <div>
          <p class="mb-4 font-mono text-xs tracking-wide text-amber-700 uppercase">A meta harness for research queries</p>
          <h1 class="max-w-[21ch] text-4xl/[1.08] font-medium tracking-[-0.045em] text-pretty text-neutral-950 sm:text-6xl/[1.06]">{title}</h1>
          <p class="mt-6 max-w-[58ch] text-lg/8 text-pretty text-neutral-600">Query search engines, AI answer engines, and deep-research APIs from one interface, and keep every answer with its citations.</p>
          <p class="mt-6 max-w-[58ch] text-lg/8 text-pretty text-neutral-600">{description}</p>
          <div class="mt-8 flex flex-wrap items-center gap-x-7 gap-y-4">
            <a href={ctaHref} class="inline-flex items-center gap-2 rounded bg-neutral-950 px-4 py-2.5 text-base font-medium text-white hover:bg-neutral-800 sm:text-sm">{ctaLabel} <Icon name="arrowRight" /></a>
            <a href="#setup" class="inline-flex items-center gap-2 py-2 text-base font-medium text-neutral-700 hover:text-neutral-950 sm:text-sm">Set it up</a>
            <CopyPageButton href={markdownHref} />
          </div>
        </div>
        <div class="lg:pb-2">
          <p class="text-sm text-neutral-500">Works with the agent you already use</p>
          <ul class="mt-4 grid grid-cols-3 gap-2 sm:grid-cols-6 lg:grid-cols-3" aria-label="Supported coding agents">
            {hosts.filter((host) => host.logo).map((host) => (
              <li>
                <a href={`#host-tab-${host.id}`} data-host-link={host.id} class="flex h-full flex-col items-center gap-2 rounded-md border border-neutral-200 bg-white px-2 py-3 text-center text-xs text-neutral-700 hover:border-neutral-300 hover:text-neutral-950">
                  <span class="logo-tile flex size-8 items-center justify-center rounded-md"><img src={host.logo} alt="" width="20" height="20" class="size-5" /></span>
                  {host.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <!-- How you'd use it: an illustrative agent session over MCP. -->
    <section class="py-16 sm:py-24" aria-labelledby="usage-heading">
      <div class="mx-auto max-w-6xl px-6 lg:px-8">
        <h2 id="usage-heading" class={sectionHeading}>Ask a question. Your agent does the reading.</h2>
        <p class="mt-5 max-w-[62ch] text-lg/8 text-pretty text-neutral-600">You ask in plain language. Your agent previews sources, researches, resumes the slow ones, and reads every saved page before it answers, with each finding still tied to its source.</p>

        <div class="mt-12 grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1.55fr)_minmax(0,1fr)] lg:gap-12">
          <figure class="min-w-0 overflow-hidden rounded-lg border border-neutral-200 bg-white">
            <div class="flex items-center justify-between gap-4 border-b border-neutral-200 bg-[#faf9f6] px-4 py-3 sm:px-5">
              <div class="flex items-center gap-2">
                <span class="flex gap-1.5" aria-hidden="true"><span class="size-2.5 rounded-full bg-neutral-300 dark:bg-neutral-600"></span><span class="size-2.5 rounded-full bg-neutral-300 dark:bg-neutral-600"></span><span class="size-2.5 rounded-full bg-neutral-300 dark:bg-neutral-600"></span></span>
                <span class="ml-2 font-mono text-xs whitespace-nowrap text-neutral-500"><span class="max-sm:hidden">your agent · </span>Librarium MCP</span>
              </div>
              <span class="rounded-sm border border-neutral-200 px-1.5 py-0.5 font-mono text-[11px] tracking-wide text-neutral-500 uppercase">Example session</span>
            </div>
            <ol class="space-y-4 px-4 py-6 sm:px-6" aria-label="Example agent session">
              {session.map((turn) => (
                turn.kind === "user" ? (
                  <li class="flex justify-end">
                    <div class="user-bubble max-w-[85%] rounded-lg rounded-br-sm bg-neutral-950 px-4 py-3 text-sm/6 text-pretty text-white">
                      <span class="sr-only">You: </span>{turn.text}
                    </div>
                  </li>
                ) : turn.kind === "agent" ? (
                  <li class="max-w-[90%] text-sm/6 text-pretty text-neutral-700"><span class="sr-only">Agent: </span>{turn.text}</li>
                ) : (
                  <li class="tool-call min-w-0 rounded-md border border-neutral-200 bg-neutral-50 font-mono text-xs/5">
                    <div class="flex flex-wrap items-center gap-x-2 gap-y-1 border-b border-neutral-200 px-3 py-2">
                      <Icon name="terminal" class="size-3.5 text-amber-700" />
                      <span class="text-neutral-500">Librarium</span>
                      <span class="font-semibold text-neutral-950">{turn.name}</span>
                      {turn.note && <span class="ml-auto font-sans text-[11px] text-neutral-500">{turn.note}</span>}
                    </div>
                    <dl class="grid grid-cols-[auto_minmax(0,1fr)] gap-x-3 gap-y-1 px-3 py-2">
                      <dt class="text-neutral-500">in</dt>
                      <dd class="break-words text-neutral-800">{turn.input}</dd>
                      <dt class="text-neutral-500">out</dt>
                      <dd class="break-words text-neutral-600">{turn.output}</dd>
                    </dl>
                  </li>
                )
              ))}
              <li class="rounded-md border border-amber-700/25 bg-amber-50 px-4 py-4 text-sm/6 text-neutral-700">
                <span class="sr-only">Agent: </span>
                <p class="text-neutral-950">Here’s what both passes found, with who said it:</p>
                <ul class="mt-3 space-y-3">
                  {answer.map((item) => (
                    <li>
                      <p class="text-pretty">{item.claim}</p>
                      <ul class="mt-1.5 flex flex-wrap gap-1.5" aria-label="Sources">
                        {item.sources.map((source) => (
                          <li class="source-chip inline-flex max-w-full items-center gap-1.5 rounded-sm border border-neutral-200 bg-white px-2 py-0.5 text-xs text-neutral-600">
                            <span class="font-mono text-neutral-950">{source.profile}</span>
                            <span aria-hidden="true" class="text-neutral-400">·</span>
                            <span class="truncate">{source.source}</span>
                          </li>
                        ))}
                      </ul>
                    </li>
                  ))}
                </ul>
                <p class="mt-4 text-pretty">Only the deep pass covered the IETF Idempotency-Key text, and it’s still a draft. Open it before you depend on its semantics.</p>
              </li>
            </ol>
            <figcaption class="border-t border-neutral-200 px-4 py-3 text-xs/5 text-neutral-500 sm:px-6">Example session with illustrative ids, tool output, and findings.</figcaption>
          </figure>

          <div class="min-w-0 lg:sticky lg:top-8 lg:self-start">
            <h3 class="text-lg font-semibold text-neutral-950">Things to ask your agent</h3>
            <p class="mt-2 text-base/7 text-pretty text-neutral-600 sm:text-sm/6">Paste one of these once Librarium is connected.</p>
            <ul class="mt-6 space-y-4">
              {askPrompts.map((item, index) => (
                <li class="rounded-md border border-neutral-200 bg-white p-4">
                  <div class="flex items-start justify-between gap-3">
                    <p class="text-sm font-medium text-neutral-950">{item.title}</p>
                    <button type="button" class="copy-btn group shrink-0" data-copy={item.prompt} data-copy-state="idle" aria-label={`Copy prompt: ${item.title}`}>
                      <Icon name="copy" class="size-4 group-data-[copy-state=success]:hidden" />
                      <Icon name="check" class="hidden size-4 text-amber-700 group-data-[copy-state=success]:block" />
                    </button>
                  </div>
                  <p id={`ask-${index}`} class="mt-2 text-sm/6 text-pretty text-neutral-600">{item.prompt}</p>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Setup: install, setup prompt, and per-host registration tabs. -->
    <section id="setup" class="scroll-mt-6 border-t border-neutral-200 bg-[#faf9f6] py-16 sm:py-24" aria-labelledby="setup-heading">
      <div class="mx-auto max-w-6xl px-6 lg:px-8">
        <h2 id="setup-heading" class={sectionHeading}>Set it up once.</h2>
        <div class="mt-12 grid grid-cols-1 gap-6 lg:grid-cols-2">
          <div class="flex min-w-0 flex-col rounded-lg border border-neutral-200 bg-white p-6">
            <p class="font-mono text-xs tracking-wide text-neutral-500 uppercase">One install, two ways to work</p>
            <h3 class="mt-3 text-xl font-medium tracking-tight text-neutral-950">Install the CLI</h3>
            <p class="mt-2 text-base/7 text-pretty text-neutral-600 sm:text-sm/6">Your agent gets research through the same CLI you use. Install it once:</p>
            <div class="mt-4"><ResearchSteps /></div>
            <p class="mt-4 text-base/7 text-pretty text-neutral-600 sm:text-sm/6" set:html={inline("The MCP server and the agent skill ship with that install. [Getting started](/docs#install) covers installation, and the [CLI page](/cli) covers terminal use.")} />
          </div>
          <div class="flex min-w-0 flex-col rounded-lg border border-neutral-200 bg-white p-6">
            <p class="font-mono text-xs tracking-wide text-neutral-500 uppercase">Or let your agent do it</p>
            <h3 class="mt-3 text-xl font-medium tracking-tight text-neutral-950">Choose your agent below</h3>
            <p class="mt-2 text-base/7 text-pretty text-neutral-600 sm:text-sm/6">Each agent tab has its own setup prompt and manual registration instructions. Choose your host, then copy its prompt to install and verify Librarium.</p>
            <p class="mt-4 text-base/7 text-pretty text-neutral-600 sm:text-sm/6" set:html={inline("The agent reads [install.md](/install.md) for Node.js requirements, MCP registration, source setup, and offline verification.")} />
          </div>
        </div>

        <div class="mt-6 overflow-hidden rounded-lg border border-neutral-200 bg-white">
          <div class="px-6 pt-6">
            <h3 class="text-xl font-medium tracking-tight text-neutral-950">Register the MCP server in your agent</h3>
            <p class="mt-2 max-w-[70ch] text-base/7 text-pretty text-neutral-600 sm:text-sm/6" set:html={inline("Every host launches the same local command: `librarium mcp`. The registration spelling differs per host, so use your own agent's form below.")} />
            <p class="mt-2 max-w-[70ch] text-base/7 text-pretty text-neutral-600 sm:text-sm/6" set:html={inline("Default to user-wide unless you ask for this project only. Your agent uses its known client, asks only if it cannot tell or you want a different one, and confirms the client and scope before changing configuration. Merge entries without replacing other servers. If a host cannot find `librarium`, use the absolute path printed by `command -v librarium`.")} />
          </div>
          <noscript><style is:inline>[data-host-panel][hidden]{display:block !important}#host-tabs{display:none !important}</style></noscript>
          <div id="host-tabs" role="tablist" aria-label="Coding agent" class="host-tabs mt-5 grid grid-cols-2 gap-2 border-b border-neutral-200 px-4 pb-4 sm:grid-cols-3 sm:px-5 lg:grid-cols-5">
            {hosts.map((host, index) => (
              <button type="button" role="tab" id={`host-tab-${host.id}`} aria-selected={index === 0 ? "true" : "false"} aria-controls={`host-panel-${host.id}`} tabindex={index === 0 ? 0 : -1} class="flex min-h-12 min-w-0 cursor-pointer items-center gap-2 rounded-md border border-neutral-200 px-3 py-2 text-left text-sm text-neutral-500 hover:text-neutral-950 aria-selected:border-amber-700 aria-selected:font-medium aria-selected:text-neutral-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700">
                {host.logo
                  ? <span class="logo-tile flex size-6 shrink-0 items-center justify-center rounded"><img src={host.logo} alt="" width="16" height="16" class="size-4" /></span>
                  : <span class="flex size-6 items-center justify-center rounded border border-neutral-200 text-neutral-600"><Icon name="plus" class="size-3.5" /></span>}
                <span>{host.name}</span>
              </button>
            ))}
          </div>
          {hosts.map((host, index) => (
            <div id={`host-panel-${host.id}`} role="tabpanel" aria-labelledby={`host-tab-${host.id}`} tabindex="0" data-host-panel hidden={index !== 0} class="p-6 focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-amber-700">
              <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
                <div class="flex items-center gap-3">
                  {host.logo
                    ? <span class="logo-tile flex size-10 items-center justify-center rounded-md border border-neutral-200"><img src={host.logo} alt="" width="24" height="24" class="size-6" /></span>
                    : <span class="flex size-10 items-center justify-center rounded-md border border-neutral-200 text-neutral-600"><Icon name="terminal" class="size-5" /></span>}
                  <p class="text-lg font-medium text-neutral-950">{host.id === "other" ? "Any other MCP host" : host.name}</p>
                </div>
                {host.docs.length > 0 && (
                  <p class="flex flex-wrap gap-x-5 gap-y-1 text-sm">
                    {host.docs.map((doc) => (
                      <a href={doc.href} class={codeLink}>{host.name} {doc.label} <Icon name="arrowUpRight" class="inline-block" /></a>
                    ))}
                  </p>
