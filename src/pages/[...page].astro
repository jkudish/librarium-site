---
import { render, type CollectionEntry } from "astro:content";
import { getArticles } from "../lib/articles";
import ArticleLayout from "../layouts/ArticleLayout.astro";

export async function getStaticPaths() {
  return (await getArticles()).map(({ path, entry }) => ({ params: { page: path }, props: { entry } }));
}
const { entry } = Astro.props as { entry: CollectionEntry<"pages"> | CollectionEntry<"guides"> };
const { Content, headings } = await render(entry);
const page = entry.collection === "pages" ? entry.data : undefined;
---

<ArticleLayout title={entry.data.title} description={entry.data.description} headings={headings}
  kind={page?.kind ?? "guide"} redirect={page?.redirect} ctaHref={page?.ctaHref} ctaLabel={page?.ctaLabel}>
  <Content />
</ArticleLayout>
