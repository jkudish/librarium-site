---
// Dedicated product page for /laravel. src/content/pages/laravel.md stays
// the source of truth for the agent-readable twin at /laravel.md (served by
// [...page].md.ts and bundled into the llms files). Every PHP example below
// is read from that file's fenced blocks, so the page and its Markdown
// cannot drift apart.
//
// Output examples are illustrative; no live provider result is implied.
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import ProductHero from "../components/ProductHero.astro";
import CopyPageButton from "../components/CopyPageButton.astro";
import CodePanel from "../components/CodePanel.astro";
import ResearchSteps from "../components/ResearchSteps.astro";
import TerminalBlock, { type TerminalLine } from "../components/TerminalBlock.astro";
import { inline } from "../lib/inline-markup";
import { fencedBlocks, pickBlock } from "../lib/markdown-code";

const entry = await getEntry("pages", "laravel");
if (!entry) throw new Error("src/content/pages/laravel.md is missing");
const { title, description, ctaHref, ctaLabel } = entry.data;
const markdownHref = "/laravel.md";
const source = "src/content/pages/laravel.md";
const blocks = fencedBlocks(entry.body ?? "");
const previewCode = pickBlock(blocks, "php", "$research = Librarium::research(", source);
const resultsCode = pickBlock(blocks, "php", "$evidence->result('exa')", source);
const queueCode = pickBlock(blocks, "php", "->then(function ($response)", source);
const promptCode = pickBlock(blocks, "php", "(new TechnicalAdvisor($evidence))->prompt(", source);

const previewSession: TerminalLine[] = [
  { prompt: ">", cmd: "$preview->status()" },
  { out: '= "planned"' },
  { prompt: ">", cmd: "$preview->toArray()['cost']['reported']" },
  { out: "= null", tone: "warn" },
  { prompt: ">", cmd: "$preview->toArray()['skipped']" },
  { out: "= […] // Inspect unpriced and over-budget sources." },
];

const agentModeJson: TerminalLine[] = [
  { cmd: "php artisan librarium:research \\\n  'Compare PostgreSQL connection-pooling options for Laravel workers.' \\\n  --only=exa --dry-run --json", accent: "--dry-run --json" },
  { out: '"spec": "librarium.run/1"' },
  { out: '"status": "planned"' },
  { out: '"depth": "quick"' },
  { out: "… remaining Run fields omitted", tone: "dim" },
];

const queueFlow = [
  { label: "Store, then dispatch", body: "`queue()` stores a running Run before dispatch and returns its `id()`." },
  { label: "One encrypted job", body: "A single Laravel job with `tries = 1` and `failOnTimeout`. A failure is never retried automatically, so paid work is not silently repeated." },
  { label: "Wait for the report", body: "Polling retrieves the completed report. Provider webhooks can prompt another check." },
  { label: "Your callback", body: "`then()` receives the Run; `catch()` receives the failure. Your app controls tenant access and workflows." },
];

const useCases = [
  { title: "A technical advisor", body: "Compare current platform documentation before proposing an architecture. Require the cited passage to support each material claim." },
  { title: "A product analyst", body: "Inspect how AI answer engines describe a luxury rental service, keeping each engine and retrieval service with its observation. Our [Agentsy Report field note](/stories/agentsy-report) shows how an application stores this evidence." },
  { title: "An editorial agent", body: "Collect source material first, then draft with citations and explicit gaps. Provider output is evidence to verify, not permission to publish its claims." },
];

const sectionHeading = "max-w-[22ch] text-3xl font-medium tracking-tight text-balance text-neutral-950 sm:text-5xl";
---

<Base title={`${title} | Librarium`} description={description} includeSoftwareMetadata={false}>
  <Header />
  <main>
    <ProductHero title={title} description={description} ctaHref={ctaHref} ctaLabel={ctaLabel} markdownHref={markdownHref} secondary={{ href: "#preview", label: "See it in code" }}>
      <ResearchSteps platform="laravel" />
    </ProductHero>

    <!-- Preview, then run. -->
    <section id="preview" class="scroll-mt-6 py-16 sm:py-24" aria-labelledby="preview-heading">
      <div class="mx-auto max-w-6xl px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-x-12 gap-y-6 lg:grid-cols-2">
          <div>
            <p class="font-mono text-xs tracking-wide text-amber-700 uppercase">Preview, then run</p>
            <h2 id="preview-heading" class={`mt-3 ${sectionHeading}`}>Research before your agent recommends.</h2>
          </div>
          <div class="lg:pt-8">
            <p class="text-base/7 text-pretty text-neutral-600">Preview the source selection and estimates. A dry run stores nothing and makes no provider call.</p>
            <p class="mt-4 text-base/7 text-pretty text-neutral-600" set:html={inline("`only()` selects flat names. PHP executes selected sources sequentially; inspect costs and skips before proceeding.")} />
          </div>
        </div>
        <CodePanel class="mt-10" label="Research step" lang="php" code={previewCode} />
        <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)]">
          <TerminalBlock class="lg:self-start" title="Inspecting $preview" kind="illustrative" badge="Illustrative" lines={previewSession} caption="Selected fields from an example preview." />
          <div class="space-y-4">
            <div class="rounded-lg border border-neutral-200 bg-white p-5">
              <p class="text-sm font-semibold text-neutral-950">Set a budget before research</p>
              <p class="mt-2 text-sm/6 text-pretty text-neutral-600" set:html={inline("Use `maxCost('0.25')` to limit which sources start. See [costs and limits](/docs/php/costs-and-limits) for selection rules and billing caveats.")} />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- The response. -->
    <section class="border-t border-neutral-200 bg-[#faf9f6] py-16 sm:py-24" aria-labelledby="response-heading">
      <div class="mx-auto max-w-6xl px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] lg:gap-12">
          <div>
            <h2 id="response-heading" class={sectionHeading}>Every result keeps its sources.</h2>
            <p class="mt-5 text-base/7 text-pretty text-neutral-600" set:html={inline("`run()` returns an immutable `Run`. Each result keeps its source, answer, citations, provenance, and safe error.")} />
            <p class="mt-4 text-base/7 text-pretty text-neutral-600" set:html={inline("`toArray()` uses the public Run format the JavaScript package validates. PHP and TypeScript describe evidence the same way while executing in their own runtimes.")} />
            <p class="mt-4 text-base/7 text-pretty text-neutral-600">Provider content and URLs remain untrusted evidence. Escape content for its output context and verify important claims against their cited sources.</p>
          </div>
          <CodePanel class="lg:self-start" label="Reading the response" lang="php" code={resultsCode} />
        </div>
      </div>
    </section>

    <!-- Queue. -->
    <section id="queue" class="scroll-mt-6 py-16 sm:py-24" aria-labelledby="queue-heading">
      <div class="mx-auto max-w-6xl px-6 lg:px-8">
        <h2 id="queue-heading" class={sectionHeading}>Queue longer research, then hand it to an agent.</h2>
        <p class="mt-5 max-w-[62ch] text-lg/8 text-pretty text-neutral-600">Save the completed Run in your own storage, then pass it into an agent or a review screen.</p>
        <div class="mt-12 grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)]">
          <CodePanel class="lg:self-start" label="Queued research" lang="php" code={queueCode} />
          <ol class="relative space-y-6 border-l border-neutral-300 pl-6 lg:mt-2" aria-label="What happens after queue()">
            {queueFlow.map((step) => (
              <li class="relative">
                <span class="absolute top-1.5 -left-[29px] size-2.5 rounded-full bg-amber-600" aria-hidden="true"></span>
                <p class="text-sm font-semibold text-neutral-950">{step.label}</p>
                <p class="mt-1 text-sm/6 text-pretty text-neutral-600" set:html={inline(step.body)} />
              </li>
            ))}
          </ol>
        </div>
        <div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-2">
          <div class="rounded-lg border border-neutral-200 bg-white p-5">
            <p class="text-sm font-semibold text-neutral-950">Recover the stored Run</p>
            <p class="mt-2 text-sm/6 text-pretty text-neutral-600" set:html={inline("`Librarium::find($id)?->refresh()` checks the saved research and returns a new snapshot without starting it again. Keep the stored Run while research is in progress.")} />
          </div>
          <div class="rounded-lg border border-neutral-200 bg-white p-5">
            <p class="text-sm font-semibold text-neutral-950">Your app owns the rest</p>
            <p class="mt-2 text-sm/6 text-pretty text-neutral-600" set:html={inline("RunStore rejects stale writes. Your application chooses storage and retention and controls tenant access, conversation memory, and the product experience. See [the queue guide](/guides/laravel-queues).")} />
          </div>
        </div>
      </div>
    </section>

    <!-- Agent tool. -->
    <section id="agent" class="scroll-mt-6 border-t border-neutral-200 bg-[#faf9f6] py-16 sm:py-24" aria-labelledby="agent-heading">
      <div class="mx-auto max-w-6xl px-6 lg:px-8">
        <h2 id="agent-heading" class={sectionHeading}>Let an AI SDK agent inspect the evidence.</h2>
        <p class="mt-5 max-w-[62ch] text-lg/8 text-pretty text-neutral-600">Separate research from reasoning. Run an approved research request, then give an AI SDK agent a read-only tool over the completed Run.</p>
        <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)]">
          <div class="min-w-0">
            <p class="mb-3 text-sm text-neutral-600" set:html={inline("Pass the `$evidence` response from the approved research step into the agent:")} />
            <CodePanel label="Prompt the agent" lang="php" code={promptCode} />
          </div>
          <div class="rounded-lg border border-neutral-200 bg-white p-5 lg:mt-8">
            <p class="text-sm font-semibold text-neutral-950">Configure your agent through the SDK</p>
            <p class="mt-2 text-sm/6 text-pretty text-neutral-700" set:html={inline("The SDK owns the agent's model and provider. Its model call has a separate budget from Librarium's research.")} />
          </div>
        </div>
        <p class="mt-8 max-w-[75ch] text-base/7 text-pretty text-neutral-600" set:html={inline("The [Laravel agent docs](/docs/php/using-with-agents#build-a-read-only-sdk-agent) include the complete `ResearchEvidence` tool and `TechnicalAdvisor` agent. For large responses, expose authorized result and citation pages instead of returning everything to the model at once.")} />

        <h3 class="mt-16 text-2xl font-medium tracking-tight text-neutral-950">Use the same pattern for different jobs</h3>
        <ul class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-3">
          {useCases.map((useCase) => (
            <li class="rounded-lg border border-neutral-200 bg-white p-5">
              <p class="text-base font-semibold text-neutral-950">{useCase.title}</p>
              <p class="mt-2 text-sm/6 text-pretty text-neutral-600" set:html={inline(useCase.body)} />
            </li>
          ))}
        </ul>
        <p class="mt-6 max-w-[75ch] text-base/7 text-pretty text-neutral-600">For on-demand research inside a tool, keep authorization and a fixed allowed source set in application code. Enforce request limits and a total spend policy across repeated tool calls; never let the model supply its own permission to spend.</p>
      </div>
    </section>

    <!-- Configure and automate. -->
    <section id="configure" class="scroll-mt-6 py-16 sm:py-24" aria-labelledby="configure-heading">
      <div class="mx-auto max-w-6xl px-6 lg:px-8">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <h2 id="configure-heading" class={sectionHeading}>Configure it like any Laravel package.</h2>
          <a href="/docs/php/configuration" class="inline-flex items-center gap-2 text-base font-medium text-amber-700 hover:text-amber-600 sm:text-sm">Configuration reference <Icon name="arrowRight" /></a>
        </div>
        <div class="mt-12 grid grid-cols-1 gap-6 lg:grid-cols-2">
          <div class="flex min-w-0 flex-col rounded-lg border border-neutral-200 bg-white p-6">
            <p class="font-mono text-xs tracking-wide text-neutral-500 uppercase">Defaults</p>
            <h3 class="mt-3 text-xl font-medium tracking-tight text-neutral-950">Publish only what you change</h3>
            <p class="mt-2 mb-5 text-base/7 text-pretty text-neutral-600 sm:text-sm/6">Start with quick research. Save groups for recurring source selections and choose a store that works across your web and queue workers.</p>
            <a href="/docs/php/configuration" class="text-sm text-amber-700 underline">Storage, queue settings, and deadlines</a>
          </div>
          <div class="flex min-w-0 flex-col rounded-lg border border-neutral-200 bg-white p-6">
            <p class="font-mono text-xs tracking-wide text-neutral-500 uppercase">Credentials</p>
            <h3 class="mt-3 text-xl font-medium tracking-tight text-neutral-950">Keys stay where Laravel keeps them</h3>
            <p class="mt-2 mb-5 text-base/7 text-pretty text-neutral-600 sm:text-sm/6" set:html={inline("SDK sources read `config/ai.php`; focused HTTP sources read `config/services.php`. Source `key` overrides belong in config, never request options. Explicitly selecting an unconfigured source fails preflight.")} />
            <a href="/docs/php/configuration#credentials" class="text-sm text-amber-700 underline">Credential configuration</a>
          </div>
        </div>
        <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)]">
          <div class="rounded-lg border border-neutral-200 bg-white p-6 lg:self-start">
            <p class="font-mono text-xs tracking-wide text-neutral-500 uppercase">Artisan</p>
            <h3 class="mt-3 text-xl font-medium tracking-tight text-neutral-950">Preview from the command line</h3>
            <p class="mt-2 text-base/7 text-pretty text-neutral-600 sm:text-sm/6" set:html={inline("`librarium:research --dry-run --json` previews offline. Remove `--dry-run` to research, or add `--no-wait` to queue. Your coding agent can read the structured JSON output.")} />
            <p class="mt-4 text-sm/6 text-pretty text-neutral-600" set:html={inline("See [Artisan commands](/docs/php/commands) for show, sources, and prune.")} />
          </div>
          <TerminalBlock title="Artisan dry run" kind="illustrative" badge="Illustrative · excerpt" lines={agentModeJson} caption="Selected fields illustrate the Run contract, not a complete JSON payload or captured provider response." />
        </div>
      </div>
    </section>

    <!-- Positioning and next steps. -->
    <section class="border-y border-neutral-300 bg-[#eeeae0] py-16 sm:py-24" aria-labelledby="native-heading">
      <div class="mx-auto max-w-6xl px-6 lg:px-8">
        <h2 id="native-heading" class={sectionHeading}>Laravel-native, not a wrapper.</h2>
        <div class="mt-12 grid grid-cols-1 gap-12 border-t border-neutral-950/15 pt-8 lg:grid-cols-2">
          <p class="text-base/7 text-pretty text-neutral-600">This is a first-party Laravel package built on the Laravel AI SDK, not a Node process in disguise. Collect research through the facade, hand it to your agents as a tool, and move long runs into encrypted queue jobs. Your app owns storage and workflows.</p>
          <p class="text-base/7 text-pretty text-neutral-600" set:html={inline("It complements the SDK: the SDK owns your agent and model interaction; Librarium supplies research results with their citations attached. Your application decides what that evidence supports. Requires PHP 8.4+, Laravel 13.30+, and Laravel AI SDK `^1.0.1`.")} />
        </div>
        <div class="mt-12 flex flex-wrap items-center gap-x-7 gap-y-4">
          <a href={ctaHref} class="inline-flex items-center gap-2 rounded bg-neutral-950 px-4 py-2.5 text-base font-medium text-white hover:bg-neutral-800 sm:text-sm">{ctaLabel} <Icon name="arrowRight" /></a>
          <a href="/guides/laravel-queues" class="inline-flex items-center gap-2 py-2 text-base font-medium text-neutral-700 hover:text-neutral-950 sm:text-sm">Read the queue guide</a>
          <CopyPageButton href={markdownHref} />
        </div>
      </div>
    </section>
    <p id="copy-status" role="status" class="sr-only"></p>
  </main>
  <Footer />
</Base>

<script>
  import "../scripts/copy-buttons";
</script>
