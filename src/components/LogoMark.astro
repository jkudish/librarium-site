---
// Librarium mark (B3 "Cut L"). Generated by the brand script; edit there.
interface Props { id: string; class?: string; title?: string }
const { id, class: className, title } = Astro.props;
---

<svg viewBox="0 0 100 100" data-brand="librarium" class={className} role={title ? "img" : undefined} aria-hidden={title ? undefined : "true"} aria-label={title}>
  <defs>
    <mask id={`${id}-2`} maskUnits="userSpaceOnUse" x="0" y="0" width="100" height="100"><rect width="100" height="100" fill="#fff" /><polygon points="15,39 23,31 35,31 35,69 65,69 65,81 57,89 15,89" fill="#000" stroke="#000" stroke-width="5.2" /><polygon points="25,29 33,21 45,21 45,59 75,59 75,71 67,79 25,79" fill="#000" stroke="#000" stroke-width="5.2" /></mask>
    <mask id={`${id}-1`} maskUnits="userSpaceOnUse" x="0" y="0" width="100" height="100"><rect width="100" height="100" fill="#fff" /><polygon points="15,39 23,31 35,31 35,69 65,69 65,81 57,89 15,89" fill="#000" stroke="#000" stroke-width="5.2" /></mask>
  </defs>
  <polygon points="35,19 43,11 55,11 55,49 85,49 85,61 77,69 35,69" fill="currentColor" fill-opacity="0.18" mask={`url(#${id}-2)`} />
  <polygon points="25,29 33,21 45,21 45,59 75,59 75,71 67,79 25,79" fill="currentColor" fill-opacity="0.45" mask={`url(#${id}-1)`} />
  <polygon points="15,39 23,31 35,31 35,69 65,69 65,81 57,89 15,89" fill="currentColor" />
</svg>
