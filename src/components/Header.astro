---
import Icon from "./Icon.astro";
interface Props { wide?: boolean; }
const { wide = false } = Astro.props;
const links = [
  { href: "/#features", label: "Features" },
  { href: "/#library", label: "Library" },
  { href: "/#providers", label: "Providers" },
  { href: "/guides", label: "Guides" },
  { href: "/docs", label: "Docs" },
];
---

<header class="border-b border-neutral-950/10">
  <div class:list={["mx-auto flex h-16 items-center justify-between px-6", wide ? "max-w-[1440px] lg:px-10" : "max-w-6xl lg:px-8"]}>
    <a href="/" aria-label="Homepage" class="flex items-center gap-x-2">
      <span class="font-mono text-base font-semibold text-neutral-950">librarium</span>
    </a>
    <nav class="flex items-center gap-x-7" aria-label="Primary navigation">
      <div class="flex items-center gap-x-5 text-sm text-neutral-600 max-md:hidden lg:gap-x-7">
        {links.map((link) => (
          <a href={link.href} class="hover:text-neutral-950">{link.label}</a>
        ))}
      </div>
      <a
        href="https://github.com/jkudish/librarium"
        class="flex items-center gap-x-2 rounded-lg px-3 py-1.5 text-sm font-medium text-neutral-700 ring-1 ring-neutral-950/15 hover:bg-neutral-950/3"
      >
        <Icon name="githubLogo" class="size-4" />
        GitHub
      </a>
      <button
        type="button"
        id="menu-toggle"
        class="relative -mr-2 rounded-lg p-2 text-neutral-600 hover:bg-neutral-950/3 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600 md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="list" class="size-6" />
        <span class="pointer-fine:hidden absolute top-1/2 left-1/2 size-[max(100%,3rem)] -translate-1/2" aria-hidden="true"></span>
      </button>
    </nav>
  </div>
  <div id="mobile-menu" hidden class="border-t border-neutral-950/10 md:hidden!">
    <nav class="mx-auto flex max-w-6xl flex-col gap-y-1 px-4 py-3" aria-label="Mobile navigation">
      {links.map((link) => (
        <a href={link.href} class="rounded-lg px-2 py-2 text-base text-neutral-700 hover:bg-neutral-950/3 hover:text-neutral-950">{link.label}</a>
      ))}
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const isOpen = !menu?.hidden;
    if (menu) menu.hidden = isOpen;
    toggle.setAttribute("aria-expanded", String(!isOpen));
  });
</script>
